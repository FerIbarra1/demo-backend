# ============================================================================
# BASE DE DATOS
# ============================================================================
# REGLA DE ORO: DATABASE_URL y DIRECT_DATABASE_URL deben apuntar a LA MISMA
# base de datos. Prisma usa `directUrl` para migraciones y `url` para la app;
# si apuntan a servidores distintos, las migraciones se aplican en uno y la
# app lee del otro (drift silencioso, difícil de diagnosticar).
#
# --- Local (Docker) ---
# Levanta la BD con: pnpm db:up
# Sin pooler, ambas variables son idénticas.
DATABASE_URL="postgresql://tienda_user:tienda_password@localhost:5432/tienda_db?schema=public"
DIRECT_DATABASE_URL="postgresql://tienda_user:tienda_password@localhost:5432/tienda_db?schema=public"

# --- Neon (nube) ---
# Neon separa el pooler (app) del endpoint directo (migraciones):
#   DATABASE_URL        -> host CON "-pooler" (PgBouncer, para la app)
#   DIRECT_DATABASE_URL -> host SIN "-pooler" (DDL; PgBouncer no soporta DDL)
# DATABASE_URL="postgresql://usuario:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://usuario:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT
# Genera un valor seguro en producción: `openssl rand -hex 32`
JWT_SECRET="cambiar-por-secreto-generado-con-openssl-rand-hex-32"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# PR7 (kiosko-profesional): secreto HMAC para tokens QR de "avisar
# llegada". NUNCA debe ser igual a JWT_SECRET — si uno se compromete,
# el otro no debe caer. Genera uno separado:
#   openssl rand -base64 48
# Si falta, main.ts aborta el arranque (mismo patrón que JWT_SECRET).
KIOSKO_QR_SECRET="cambiar-por-secreto-generado-con-openssl-rand-base64-48"

# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Redis
REDIS_URL=redis://localhost:6379

# ============================================================================
# AGENT API KEY — agente externo (Firebird/Visual FoxPro)
# ============================================================================
# Header `X-Agent-Key` que el agente externo envía en cada webhook.
# Genera un valor aleatorio en producción: `openssl rand -hex 32`.
# Si la variable NO está definida, el ApiKeyGuard rechaza toda petición.
# El endpoint afectado: POST /api/pedidos/admin/:id/marcar-pagado
AGENT_API_KEY="dev-agent-key-cambiar-en-produccion"

# ============================================================================
# MAIL (SMTP) — envío de correos transaccionales al cliente
# ============================================================================
# Dev: usar MailHog (docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# Prod: configurar con tu proveedor SMTP (Resend, SendGrid, Gmail, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="PTM Tienda <no-reply@ptm.local>"
# A dónde van las respuestas del cliente. Los correos dicen "contesta este
# correo", así que debe ser un buzón real y monitoreado. Vacío = responde al from.
SMTP_REPLY_TO=""

# URL pública del frontend. Se usa en los CTAs de los correos y como base de
# los enlaces de recuperación de contraseña. Debe ser accesible públicamente
# en prod.
FRONTEND_URL=http://localhost:3001
# Minutos de validez del token de recuperación de contraseña
PASSWORD_RESET_EXPIRES_MIN=60

# ============================================================================
# PEDIDOS SIN RECOGER (área de entrega)
# ============================================================================
# Horas desde que la bolsa quedó apartada esperando al cliente.
#  - A las PEDIDO_RECORDATORIO_HORAS se le manda "¿aún quieres tu pedido?".
#  - A las PEDIDO_VENCIDO_HORAS aparece como VENCIDO en el mostrador, que puede
#    cancelarlo (el cliente recibe el correo con el motivo). Debe ser MAYOR que
#    el recordatorio: el cliente necesita tiempo de contestar.
#  - Un aviso de llegada que nadie atendió en PRESENCIA_CADUCA_HORAS caduca solo.
PEDIDO_RECORDATORIO_HORAS=24
PEDIDO_VENCIDO_HORAS=72
PRESENCIA_CADUCA_HORAS=8

# ============================================================================
# ALMACENAMIENTO DE IMÁGENES (S3) — productos y logo
# ============================================================================
# Guarda las imágenes de producto (panel ADMIN) y el logo de los correos.
#
# Si AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY están VACÍAS, el backend cae a
# disco local (uploads/ → /files/) para que el desarrollo funcione sin AWS.
# Ese fallback es sólo para dev: en producción las credenciales son obligatorias.
#
# El bucket debe permitir LECTURA PÚBLICA de los objetos (las URLs se usan en
# <img> del catálogo, en los correos y en og:image). NO habilites ListBucket
# público — sólo GetObject.
#
# IAM mínimo necesario (NO uses s3:* ni un usuario root):
#   s3:PutObject, s3:DeleteObject sobre arn:aws:s3:::TU-BUCKET/productos/*
#   s3:PutObject, s3:DeleteObject sobre arn:aws:s3:::TU-BUCKET/tmp/*
# El segundo prefijo NO es opcional: el healthcheck del arranque escribe
# tmp/healthcheck, y sin ese permiso el log reporta un falso "S3 RECHAZA la
# escritura" aunque las subidas funcionen.
# (s3:ListBucket NO es necesario: el backend nunca lista el bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# El nombre incluye el sufijo del espacio de nombres regional de la cuenta
# (-{accountId}-{region}-an). Debe coincidir EXACTAMENTE con el bucket real:
# si no, las subidas fallan con PermanentRedirect y las URLs quedan rotas.
AWS_S3_BUCKET=ptm-tienda-imagenes-921810471247-us-west-2-an

# --- URL pública ---
# Base de la URL pública de las imágenes. Si se omite, se construye como
# https://{AWS_S3_BUCKET}.s3.{AWS_REGION}.amazonaws.com
# Ejemplos:
#   https://mi-bucket.s3.us-east-1.amazonaws.com   (bucket directo)
#   https://img.puntotextilmayoreo.com             (CloudFront / dominio propio)
#   https://pub-xxxx.r2.dev                        (Cloudflare R2)
# Si usas un dominio propio o CDN, agrégalo también al frontend en
# NEXT_PUBLIC_IMAGE_DOMAINS (next.config.ts) para que next/image lo acepte.
AWS_S3_PUBLIC_URL=

# --- Comprobantes de transferencia (PRIVADO) ---
# Los comprobantes que sube un cliente traen sus datos bancarios. Por defecto se guardan en el MISMO
# bucket de las imágenes de producto, bajo el prefijo `comprobantes/`, y el backend COMPRUEBA solo
# que ese prefijo no sea legible sin credenciales (sube un archivo de prueba, intenta leerlo por su
# URL pública y lo borra). Si lo es, se NIEGA a guardar y lo dice en el log: no hay forma de que
# publique un comprobante por accidente.
#
# Requisitos con el bucket compartido:
#   1) IAM: agrega a la política del usuario de la app
#        s3:PutObject, s3:GetObject, s3:DeleteObject sobre arn:aws:s3:::TU-BUCKET/comprobantes/*
#      (GetObject es nuevo: el backend lee los comprobantes para que Tesorería los vea).
#   2) La política del BUCKET no debe dar lectura pública a comprobantes/*. Si hoy dice
#      "Resource": "arn:aws:s3:::TU-BUCKET/*", cámbialo a productos/* y branding/* (lo que sí es público).
# Lo ideal a futuro es un bucket aparte sin lectura pública: ponlo aquí y se usa en lugar del anterior.
# Sin credenciales de S3 (dev) se guarda en ./storage-privado/, que no se sirve por HTTP.
AWS_S3_COMPROBANTES_BUCKET=
COMPROBANTE_MAX_BYTES=8388608

# --- Pagos por transferencia ---
# Horas de vigencia de las instrucciones (un abono tardío se puede verificar igual).
PAGO_TRANSFERENCIA_VENCE_HORAS=48
# Zona horaria de las fechas en correos y textos copiables.
PAGOS_ZONA_HORARIA=America/Mexico_City
# Horas que una transferencia VERIFICADA puede esperar a que la tienda la registre en VFP antes de
# marcarse "atrasada" en la cola de Tesorería (se calcula al leer; no hay proceso que avise).
PAGOS_ALERTA_SIN_REGISTRAR_HORAS=4

# --- Proveedores S3-compatibles (opcional) ---
# Deja AWS_S3_ENDPOINT vacío para usar AWS. Se usa para R2, MinIO, Spaces, etc.
# Ejemplos:
#   https://<accountid>.r2.cloudflarestorage.com   (Cloudflare R2)
#   http://localhost:9000                          (MinIO local)
AWS_S3_ENDPOINT=
# true para MinIO y la mayoría de proveedores self-hosted; false para AWS/R2.
# Con endpoint custom y sin esta variable, el SDK usa virtual-host style y
# suele fallar con "NoSuchBucket" o errores de DNS.
AWS_S3_FORCE_PATH_STYLE=false

