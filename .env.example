# ============================================================================
# BACKEND — variables de entorno
# ============================================================================
# Solo existen las que cambian ENTRE entornos (secretos, URLs, credenciales). Lo que es una regla del negocio o un
# acuerdo con otra pieza (vida de los tokens, prefijo /api, horas de recordatorio, topes de archivo…) es una constante
# en `src/config/app.config.ts`. Al arrancar, `validarEntorno` (`src/config/validar-entorno.ts`) aborta en producción
# listando TODO lo que falte o sea un valor de ejemplo.
#
# Genera cada secreto con:  openssl rand -base64 48      (AGENT_API_KEY:  openssl rand -hex 32)

# ── Base de datos ───────────────────────────────────────────────────────────────────────────────────────────────
# Local (Docker):  pnpm db:up
# Neon (conexión CON pooler): añade  &sslmode=require&pgbouncer=true&connect_timeout=15
#   pgbouncer=true  → Prisma no usa sentencias preparadas (el pooler no las soporta)
#   connect_timeout → Neon suspende el cómputo a los 5 min sin uso y tarda unos segundos en despertar
DATABASE_URL="postgresql://tienda_user:tienda_password@localhost:5432/tienda_db?schema=public"
# SOLO si la BD está detrás de un pooler (Neon: host con "-pooler" en DATABASE_URL y host SIN "-pooler" aquí, porque
# PgBouncer no soporta DDL/migraciones). Con Postgres propio o local, BORRA esta línea y la `directUrl` de
# prisma/schema.prisma: una sola URL. Si las dos existen, deben apuntar a LA MISMA base (si no, las migraciones se
# aplican en un lado y la app lee del otro).
DIRECT_DATABASE_URL="postgresql://tienda_user:tienda_password@localhost:5432/tienda_db?schema=public"

# ── Secretos ────────────────────────────────────────────────────────────────────────────────────────────────────
# Firma de los JWT. ≥32 caracteres en producción. Con uno débil se pueden forjar tokens de ADMIN.
JWT_SECRET="cambiar-por-un-secreto-generado"
# Firma de los QR de "avisar llegada" / kiosko. ≥32 caracteres y DISTINTO de JWT_SECRET (si uno se compromete, el otro
# no debe caer).
KIOSKO_QR_SECRET="cambiar-por-otro-secreto-generado"
# Header X-Agent-Key del agente del Sistema Comercial (Firebird/VFP): autentica `/sync/agent/*` y el cobro manual.
AGENT_API_KEY="cambiar-por-una-clave-del-agente"

# ── Frontend ────────────────────────────────────────────────────────────────────────────────────────────────────
# URL pública del frontend (en producción, https). Es el ÚNICO origen CORS permitido (HTTP y WebSocket) y la base de
# los enlaces de los correos. Para que la cookie de sesión funcione en Safari/Chrome, sirve el front y la API bajo el
# MISMO dominio registrable (app.tudominio.com / api.tudominio.com).
FRONTEND_URL=http://localhost:3001

# ── Correo (SMTP) ───────────────────────────────────────────────────────────────────────────────────────────────
# Desarrollo: MailHog (docker, ya viene en docker-compose: puerto 1025, UI en :8025). Producción: tu proveedor (Resend,
# SendGrid, Gmail con contraseña de aplicación…). El puerto 465 usa TLS implícito; 587/1025, STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Punto Textil Mayoreo <no-reply@ptm.local>"
# Opcional. A dónde responde el cliente ("contesta este correo"): un buzón real y monitoreado. Vacío = responde al from.
SMTP_REPLY_TO=

# ── Imágenes y archivos (AWS S3) ────────────────────────────────────────────────────────────────────────────────
# Sin credenciales el backend cae a disco local (`uploads/` → `/files/`, `storage-privado/`): SOLO para desarrollo.
# En producción son obligatorias (el disco del contenedor se pierde en cada despliegue).
# Bucket PÚBLICO (lectura de objetos, sin ListBucket): fotos de producto y logo. Las URLs públicas se DERIVAN de
# bucket + región: https://<bucket>.s3.<región>.amazonaws.com — el frontend necesita ese mismo host en
# NEXT_PUBLIC_S3_HOST.
# IAM mínimo: s3:PutObject y s3:DeleteObject sobre  TU-BUCKET/productos/*  y  TU-BUCKET/tmp/*  (el healthcheck del
# arranque escribe tmp/healthcheck); el backend nunca lista el bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
# Debe coincidir EXACTAMENTE con el bucket real (incluye el sufijo regional de la cuenta, p. ej. …-us-west-2-an): si no,
# las subidas fallan con PermanentRedirect y las URLs quedan rotas.
AWS_S3_BUCKET=
# Opcional pero RECOMENDADO en producción: UN bucket PRIVADO (sin lectura pública) para los comprobantes de transferencia
# (traen datos bancarios) y los archivos DTF, bajo los prefijos `comprobantes/` y `dtf/`. IAM: Put/Get/DeleteObject
# sobre `comprobantes/*` y `dtf/*`. Sin él se usan esos prefijos del bucket público, y el backend COMPRUEBA al guardar que
# no sean legibles sin credenciales (se niega a guardar si lo son).
AWS_S3_PRIVATE_BUCKET=

# ── Opcionales (tienen un valor por defecto sensato) ────────────────────────────────────────────────────────────
# PORT=3000
# Zona horaria del "día del negocio" de la conciliación de pagos (Mexicali y la frontera no son hora del centro).
# PAGOS_ZONA_HORARIA=America/Mexico_City
# Proxies delante del backend. Por defecto 1 en producción (nginx / balanceador) y 0 en desarrollo. NUNCA más de los que
# hay: con un número mayor un cliente falsifica X-Forwarded-For y esquiva el límite de peticiones.
# TRUST_PROXY_HOPS=1
# Tope de memoria (MB) del proceso que analiza los archivos DTF. Por defecto 2048. En un contenedor de 512 MB (Render
# gratis) pon ~256: así un archivo grande mata al proceso hijo y no al contenedor entero.
# DTF_PREFLIGHT_MEMORIA_MB=256
