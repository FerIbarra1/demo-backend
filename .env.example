# Database
DATABASE_URL="postgresql://tienda_user:tienda_password@localhost:5432/tienda_db?schema=public"

# JWT
JWT_SECRET="PI4peXDVKCqpVN1QeXynhSpVX8EmPOFpwLqI3AKzbvc="
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Redis
REDIS_URL=redis://localhost:6379

# ============================================================================
# AGENT API KEY — agente externo (Firebird/Visual FoxPro)
# ============================================================================
# Header `X-Agent-Key` que el agente externo envía en cada webhook.
# Genera un valor aleatorio en producción: `openssl rand -hex 32`.
# Si la variable NO está definida, el ApiKeyGuard rechaza toda petición.
# El endpoint afectado: POST /api/pedidos/admin/:id/marcar-pagado
AGENT_API_KEY="dev-agent-key-cambiar-en-produccion"

# ============================================================================
# MAIL (SMTP) — envío de correos transaccionales al cliente
# ============================================================================
# Dev: usar MailHog (docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog)
# Prod: configurar con tu proveedor SMTP (Resend, SendGrid, Gmail, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="PTM Tienda <no-reply@ptm.local>"

# UI: el logo del email se sirve desde el frontend (Logo.png en /public).
# Asegurate de que FRONTEND_URL sea accesible públicamente en prod para que
# Gmail/Outlook puedan cargar la imagen.
FRONTEND_URL=http://localhost:3001
# Minutos de validez del token de recuperación de contraseña
PASSWORD_RESET_EXPIRES_MIN=60

