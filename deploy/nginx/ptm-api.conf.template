# nginx delante de la api (un solo salto: TRUST_PROXY_HOPS=1 es el valor por defecto en producción).
# `${DOMINIO_API}` lo sustituye la imagen de nginx al arrancar; las variables de nginx ($host…) quedan tal cual.

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

upstream ptm_api {
  server api:3000;
  keepalive 16;
}

server {
  listen 80;
  server_name ${DOMINIO_API};

  # Renovación de certificados (certbot, modo webroot) y un sondeo simple para el monitor de disponibilidad.
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location = /healthz { access_log off; add_header Content-Type text/plain; return 200 'ok'; }

  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMINIO_API};

  ssl_certificate     /etc/letsencrypt/live/${DOMINIO_API}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMINIO_API}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;

  # Archivos DTF: 300 MB por archivo (DTF_MAX_BYTES) más el cuerpo multipart. Sin esto nginx corta con 413.
  client_max_body_size 320m;

  proxy_http_version 1.1;
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  # La api toma la ÚLTIMA entrada (la que pone nginx): un cliente no puede falsificar su IP.
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Connection        "";

  # Socket.IO: websocket con conexiones largas (el servidor corta el socket al vencer el JWT y el cliente reconecta).
  location /socket.io/ {
    proxy_pass http://ptm_api;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /api/health {
    proxy_pass http://ptm_api;
    access_log off;
  }

  location / {
    proxy_pass http://ptm_api;
    proxy_connect_timeout 10s;
    # Subidas grandes por redes de tienda lentas: no cortar a mitad de un PDF de 200 MB.
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_request_buffering off;
  }
}
