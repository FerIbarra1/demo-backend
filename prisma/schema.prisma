generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl sólo se usa para migraciones/DDL. En Neon apunta al endpoint
  // SIN pooler (PgBouncer no soporta DDL); en local es idéntico a url.
  // Prisma EXIGE que la variable exista aunque su valor sea igual a url:
  // si falta, el CLI aborta con "Environment variable not found".
  // Ambas deben apuntar a la MISMA base — ver .env.
  directUrl = env("DIRECT_DATABASE_URL")
}

// PR7 (sep 2026): canal por el que se anunció la llegada a tienda. Es
// ORTOGONAL al estado del pedido (la llegada puede ocurrir en cualquier
// estado). Ver Pedido.llegadaAnunciadaAt.
enum CanalLlegada {
  QR
  FOLIO
  WEB
  MOSTRADOR
}

// ==================== ENUMS ====================

enum RolUsuario {
  CLIENTE
  BODEGA
  BODEGA_MONITOR
  CAJERO
  CAJERO_MONITOR
  MOSTRADOR
  // F13 (sep 2026): asesor de ventas. Uno por tienda, SIN asignación 1:1 —
  // ve la cola de pedidos que el cliente escaló desde una propuesta de bodega.
  // Tiene el chat con el cliente (el bodeguero ya no lo tiene) y arma la
  // contrapropuesta de productos, cantidades y variantes.
  VENTAS
  ADMIN
}

enum EstadoPedido {
  PENDING_REVIEW
  REVIEWING
  WAITING_CUSTOMER_APPROVAL
  // F13 (sep 2026): el cliente pidió un asesor de ventas, o rechazó la
  // propuesta del vendedor y quiere re-negociar. El pedido sale de la cola
  // de bodega y entra a la cola de VENTAS de su tienda.
  EN_ASESORIA
  PENDING_PAID
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

// F12 (sep 2026): estado de una propuesta de ajuste que bodega envía al
// cliente cuando faltan productos. El pedido pasa a WAITING_CUSTOMER_APPROVAL
// mientras la propuesta está PENDIENTE.
//
// F13 (sep 2026): la semántica de la respuesta cambió. Ya no vuelve a
// REVIEWING a que el bodeguero confirme:
//   - ACEPTAR  → el pedido pasa DIRECTO a PENDING_PAID (bodega ya verificó
//                físicamente lo que propuso, no hay nada que confirmar).
//   - RECHAZAR → el pedido se CANCELA y sus productos entran a la lista de
//                reposición de bodega.
//   - SUPERADA → el cliente pidió un asesor de ventas, así que esta propuesta
//                (de bodega) queda sin efecto y el pedido pasa a EN_ASESORIA.
enum EstadoPropuesta {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  SUPERADA
}

enum CanalOrigen {
  WEB
  KIOSKO
}

// F8 (jul 2026): modo de entrega del pedido. Determina qué datos se requieren
// al crearlo desde el checkout y cómo lo procesa bodega/mostrador.
// - DOMICILIO: requiere dirección + colonia + CP + paquetería (o "admin decide").
// - RECOGER_TIENDA: el cliente recoge en tienda. Sin fecha ni hora programada
//   (se eliminaron en sep 2026: el cliente llega cuando puede).
// - KIOSKO: siempre recoger en tienda. El canalOrigen debe ser KIOSKO.
enum ModoEntrega {
  DOMICILIO
  RECOGER_TIENDA
  KIOSKO
}

// F8 (jul 2026): paqueterías soportadas para envío a domicilio. El cliente
// elige una o, alternativamente, deja que el admin decida (ver
// Pedido.dejarAdminDecidePaqueteria).
enum Paqueteria {
  ALBATROS
  TUFESA
  ESTAFETA
  DHL
  FEDEX
  PAQUETEXPRESS
}

enum CanalNotificacion {
  EMAIL
}

enum TipoNotificacion {
  PEDIDO_RECIBIDO
  REVISION_PROPUESTA
  REVISION_APROBADA
  REVISION_RECHAZADA
  PAGO_CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
  MENSAJE_BODEGUERO
  RESET_PASSWORD
  BIENVENIDA
  // F13 (sep 2026): el cliente pidió un asesor de ventas. Se manda al cliente
  // (confirmación de que alguien lo contactará) y al equipo de ventas.
  ASESOR_SOLICITADO
  // F13: el asesor de ventas envió una contrapropuesta al cliente.
  PROPUESTA_VENTAS
}

enum EstadoSurtido {
  PENDIENTE // Aún no se ha trabajado este item
  PARCIAL // Se surtió menos de lo pedido (pero algo sí)
  COMPLETO // Se surtió todo lo pedido
  NO_DISPONIBLE // No se pudo surtir nada
}

// F13 (sep 2026): estado de la lista de reposición de bodega. Cuando el
// cliente rechaza una propuesta, los productos del pedido tienen que volver
// físicamente al anaquel. Como el modelo B2B no maneja inventario (el modelo
// Stock se eliminó — ver comentario más abajo), esto es un AVISO OPERATIVO
// con confirmación humana, no un contador que se suma.
enum EstadoReposicion {
  PENDIENTE // Bodega todavía no ha repuesto la mercancía
  REPUESTO // Bodega confirmó que los productos volvieron al anaquel
}

enum EstadoKiosko {
  ACTIVO
  INACTIVO
}

// ==================== ENTIDADES CORE ====================

model Tienda {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  direccion  String   @db.VarChar(255)
  ciudad     String   @db.VarChar(50)
  estado     String   @db.VarChar(50)
  telefono   String?  @db.VarChar(20)
  email      String?  @db.VarChar(100)
  activa     Boolean  @default(true)
  // F9 (ago 2026): ID de la tienda en Firebird (TIENDAS.IDTIENDA). Único
  // porque hay una sola BD Firebird central para todas las tiendas y la
  // relación nube↔local es 1:1 por tienda.
  externalId Int?     @unique @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relaciones
  usuarios        Usuario[]
  usuariosCliente UsuarioTienda[]
  productosTienda ProductoTienda[]
  precios         Precio[]
  preciosCO       PrecioCO[]
  pedidos         Pedido[]
  kioskos         Kiosko[]
  // SyncModule: checkpoint por tienda (último BANDEJA_SYNC.ID procesado).
  checkpoint      SyncCheckpoint?
  // F11 (ago 2026): ventanillas físicas del módulo de cajeros (1, 2, 3...).
  // Cada ventanilla puede estar asignada a un cajero a la vez.
  ventanillas     Ventanilla[]
  // F9 ago 2026: inbox de eventos Firebird→nube por tienda.
  syncEventInbox  SyncEventInbox[]

  @@map("tiendas")
}

model Usuario {
  id                Int        @id @default(autoincrement())
  email             String     @unique @db.VarChar(100)
  password          String     @db.VarChar(255)
  nombre            String     @db.VarChar(100)
  apellido          String?    @db.VarChar(100)
  telefono          String?    @db.VarChar(20)
  rol               RolUsuario @default(CLIENTE)
  activo            Boolean    @default(true)
  tiendaId          Int?       @map("tienda_id")
  emailVerified     Boolean    @default(false) @map("email_verified")
  lastLogin         DateTime?  @map("last_login")
  // F7 (jul 2026): ping cada 5min desde la tablet del bodeguero/cajero/mostrador.
  // El monitor lo usa junto con lastLogin para decidir si el operador está
  // "activo en su estación" (no sólo logueado alguna vez).
  ultimoHeartbeat   DateTime?  @map("ultimo_heartbeat")
  // F9 (ago 2026): código de lista de precios del cliente sincronizado
  // desde Firebird (CLIENTES.LISPRE '1'..'6'). El catálogo lo usa para
  // elegir qué columna de Precio.listaX mostrar al cliente logueado.
  listaPrecioCodigo String?    @map("lista_precio_codigo") @db.VarChar(2)
  // Soft delete: marca el usuario como eliminado sin borrar la fila, para
  // conservar pedidos/historial. `activo=false` = desactivado (reactivable);
  // `deletedAt != null` = eliminado (no aparece en listados). Los clientes
  // nunca se eliminan (solo se desactivan).
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relaciones
  tienda                  Tienda?              @relation(fields: [tiendaId], references: [id])
  tiendasCliente          UsuarioTienda[]
  pedidos                 Pedido[]             @relation("PedidoCliente")
  pedidosAsignados        Pedido[]             @relation("PedidoBodeguero")
  pedidosEnCaja           Pedido[]             @relation("PedidoCajero")
  actividades             LogActividad[]
  propuestasCreadas       PedidoPropuesta[]    @relation("PropuestaCreador")
  propuestasForzadas      PedidoPropuesta[]    @relation("PropuestaForzador")
  // F13 (sep 2026): bodeguero que confirmó que la mercancía de un pedido
  // cancelado volvió al anaquel.
  reposicionesRepuestas   PedidoReposicion[]   @relation("ReposicionReponedor")
  mensajes                PedidoMensaje[]
  favoritos               Favorito[]
  kioskosActivados        Kiosko[]             @relation("KioskoActivador")
  kioskosDesactivados     Kiosko[]             @relation("KioskoDesactivador")
  kioskoPairingsAprobados KioskoPairing[]      @relation("KioskoPairingAprobador")
  // PR7 (sep 2026): operador que descartó avisos de llegada en mostrador.
  llegadasDescartadas     Pedido[]             @relation("PedidoLlegadaDescartada")
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  // F11 (ago 2026): ventanilla física donde trabaja el cajero (1:1 nullable).
  // Se setea vía POST /cajero/ventanilla/elegir.
  ventanilla              Ventanilla?

  @@map("usuarios")
}

model UsuarioTienda {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @map("usuario_id")
  tiendaId          Int      @map("tienda_id")
  localClienteId    Int?     @map("local_cliente_id")
  listaPrecioCodigo String?  @map("lista_precio_codigo") @db.VarChar(2)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  // F9: la migración 2212 pone DEFAULT CURRENT_TIMESTAMP. Mantenemos el default
  // para que coincida con BD. @updatedAt de Prisma lo sobreescribe en updates.
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tienda  Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tiendaId])
  @@index([tiendaId, localClienteId])
  @@map("usuarios_tiendas")
}

// F11 (ago 2026): ventanilla física de la tienda. La cantidad de
// ventanillas por tienda las define el admin. El cajero elige en cuál
// va a trabajar al iniciar sesión (1:1 con cajero vía cajeroId único).
model Ventanilla {
  id        Int      @id @default(autoincrement())
  tiendaId  Int      @map("tienda_id")
  numero    Int // 1, 2, 3... definido por el admin.
  // FK opcional a Usuario. Si está null, la ventanilla está libre.
  cajeroId  Int?     @unique @map("cajero_id")
  activa    Boolean  @default(true) @map("activa")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  tienda Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  cajero Usuario? @relation(fields: [cajeroId], references: [id], onDelete: SetNull)

  @@unique([tiendaId, numero])
  @@index([tiendaId])
  @@map("ventanillas")
}

// Sesion eliminada en refactor B2B: auth stateless JWT.
// Reintroducir con migración si se reactiva revocación de refresh tokens.

// ==================== CATÁLOGO ====================

model Producto {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique @db.VarChar(50)
  nombre          String   @db.VarChar(150)
  descripcion     String?  @db.Text
  imagenPrincipal String?  @map("imagen_principal") @db.VarChar(255)
  imagenes        String[]
  activo          Boolean  @default(true)
  categoria       String?  @db.VarChar(50)
  subcategoria    String?  @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relaciones
  productosTienda  ProductoTienda[]
  precios          Precio[]
  preciosCO        PrecioCO[]
  itemsPedido      ItemPedido[]
  favoritos        Favorito[]
  imagenesProducto ProductoImagen[]

  @@map("productos")
}

// ==================== IMÁGENES DE PRODUCTO ====================
// Las imágenes se gestionan desde el panel ADMIN (S3). Los productos
// vienen de Firebird y NO se editan; aquí solo se asocian imágenes.
// Hasta 4 imágenes por (producto, color). colorId null = imagen general
// del producto (sin variante de color).
model ProductoImagen {
  id          Int      @id @default(autoincrement())
  productoId  Int      @map("producto_id")
  colorId     Int?     @map("color_id")
  url         String   @db.VarChar(500)
  orden       Int      @default(0)
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  color    Color?   @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productoId, colorId])
  @@index([productoId, esPrincipal])
  @@map("productos_imagenes")
}

model ProductoTienda {
  id         Int     @id @default(autoincrement())
  productoId Int     @map("producto_id")
  tiendaId   Int     @map("tienda_id")
  visible    Boolean @default(true)
  destacado  Boolean @default(false)
  orden      Int     @default(0)

  // Relaciones
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda   Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([productoId, tiendaId])
  @@map("productos_tienda")
}

// ==================== CORRIDAS Y TALLAS ====================

model Corrida {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(50)
  descripcion String? @db.VarChar(100)
  activa      Boolean @default(true)

  // Relaciones
  tallas    Talla[]
  preciosCO PrecioCO[]

  @@map("corridas")
}

model Talla {
  id        Int    @id @default(autoincrement())
  corridaId Int    @map("corrida_id")
  nombre    String @db.VarChar(10)
  orden     Int    @default(0)

  // Relaciones
  corrida   Corrida    @relation(fields: [corridaId], references: [id], onDelete: Cascade)
  preciosCO PrecioCO[]

  @@unique([corridaId, nombre])
  @@map("tallas")
}

// ==================== COLORES ====================

model Color {
  id     Int     @id @default(autoincrement())
  codigo String  @unique @db.VarChar(10)
  nombre String  @db.VarChar(30)
  hex    String? @db.VarChar(7)
  activo Boolean @default(true)

  // Relaciones
  preciosCO        PrecioCO[]
  imagenesProducto ProductoImagen[]

  @@map("colores")
}

// ==================== PRECIOS ====================

model Precio {
  id            Int       @id @default(autoincrement())
  productoId    Int       @map("producto_id")
  tiendaId      Int       @map("tienda_id")
  precioBase    Decimal   @map("precio_base") @db.Decimal(10, 2)
  precioOferta  Decimal?  @map("precio_oferta") @db.Decimal(10, 2)
  activo        Boolean   @default(true)
  vigenciaDesde DateTime? @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date

  // F9 (ago 2026): 6 listas de precios sincronizadas desde Firebird
  // (PRECIOS.PRECIO1..6). precioBase sigue siendo sinónimo de lista1 para
  // compatibilidad con la API y frontend actuales.
  lista1 Decimal @default(0) @map("lista1") @db.Decimal(10, 2)
  lista2 Decimal @default(0) @map("lista2") @db.Decimal(10, 2)
  lista3 Decimal @default(0) @map("lista3") @db.Decimal(10, 2)
  lista4 Decimal @default(0) @map("lista4") @db.Decimal(10, 2)
  lista5 Decimal @default(0) @map("lista5") @db.Decimal(10, 2)
  lista6 Decimal @default(0) @map("lista6") @db.Decimal(10, 2)

  // Relaciones
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda   Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([productoId, tiendaId])
  @@map("precios")
}

// PRECIOSCO - Precios específicos por talla/color con stock
model PrecioCO {
  id         Int     @id @default(autoincrement())
  productoId Int     @map("producto_id")
  tiendaId   Int     @map("tienda_id")
  corridaId  Int     @map("corrida_id")
  tallaId    Int     @map("talla_id")
  colorId    Int     @map("color_id")
  precio     Decimal @db.Decimal(10, 2)
  sku        String? @unique @db.VarChar(50)

  // F9 (ago 2026): 6 listas de precios sincronizadas desde Firebird
  // (PRECIOSCO.PRECIO1..6). `precio` sigue siendo sinónimo de lista1.
  lista1 Decimal @default(0) @map("lista1") @db.Decimal(10, 2)
  lista2 Decimal @default(0) @map("lista2") @db.Decimal(10, 2)
  lista3 Decimal @default(0) @map("lista3") @db.Decimal(10, 2)
  lista4 Decimal @default(0) @map("lista4") @db.Decimal(10, 2)
  lista5 Decimal @default(0) @map("lista5") @db.Decimal(10, 2)
  lista6 Decimal @default(0) @map("lista6") @db.Decimal(10, 2)

  // Relaciones
  producto                Producto     @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda                  Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  corrida                 Corrida      @relation(fields: [corridaId], references: [id], onDelete: Cascade)
  talla                   Talla        @relation(fields: [tallaId], references: [id], onDelete: Cascade)
  color                   Color        @relation(fields: [colorId], references: [id], onDelete: Cascade)
  itemsPedido             ItemPedido[]
  sustitucionesPropuestas ItemPedido[] @relation("SustitucionPropuesta")

  @@unique([productoId, tiendaId, corridaId, tallaId, colorId])
  @@map("preciosco")
}

// Stock eliminado en refactor B2B: el modelo B2B no maneja inventario confiable.
// La columna Stock.cantidadReservada quedó sin uso. Reintroducir con migración si
// en el futuro se reactiva control de stock contra entrega.

// ==================== PEDIDOS B2B ====================

model Pedido {
  id           Int          @id @default(autoincrement())
  numeroPedido String       @unique @map("numero_pedido") @db.VarChar(20)
  usuarioId    Int          @map("usuario_id")
  tiendaId     Int          @map("tienda_id")
  estado       EstadoPedido @default(PENDING_REVIEW)
  canalOrigen  CanalOrigen  @default(WEB) @map("canal_origen")
  // KIOSKO: si el pedido se originó en un kiosko físico, apunta al kiosko
  // que lo creó. NULL = pedido web. Permite trazabilidad: el cliente ve en su
  // historial "Pedido X hecho en kiosko Y, tienda Z".
  kioskoId     Int?         @map("kiosko_id")
  notas        String?      @db.Text

  // Información del cliente (snapshot, capturada al crear el pedido)
  clienteNombre   String  @map("cliente_nombre") @db.VarChar(100)
  clienteEmail    String  @map("cliente_email") @db.VarChar(100)
  clienteTelefono String? @map("cliente_telefono") @db.VarChar(20)

  // F8 (jul 2026): modo de entrega. Default DOMICILIO para no romper el flujo
  // legacy (frontend web siempre asume envío). El servicio lo recalcula en
  // crearPedido según los campos que llegan y el canalOrigen.
  modoEntrega ModoEntrega @default(DOMICILIO) @map("modo_entrega")

  // Envío
  shippingDireccion          String?     @map("shipping_direccion") @db.Text
  shippingReferencia         String?     @map("shipping_referencia") @db.VarChar(255)
  // F8 (jul 2026): dirección estructurada para envío a domicilio. Requeridos
  // por el service cuando modoEntrega=DOMICILIO.
  shippingColonia            String?     @map("shipping_colonia") @db.VarChar(120)
  shippingCodigoPostal       String?     @map("shipping_codigo_postal") @db.VarChar(10)
  // F8 (jul 2026): paquetería. El cliente o elige una, o marca
  // dejarAdminDecidePaqueteria=true y este campo queda NULL.
  shippingPaqueteria         Paqueteria? @map("shipping_paqueteria")
  dejarAdminDecidePaqueteria Boolean     @default(false) @map("dejar_admin_decide_paqueteria")

  // Totales
  subtotal  Decimal @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  impuestos Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // Idempotencia para reintentos del cliente
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(64)

  // Asignación a bodeguero (para el monitor de bodega)
  // Se setea en /pedidos/bodega/:id/tomar. SetNull si el bodeguero se elimina.
  // Se limpia al confirmar surtido (el pedido pasa a PENDING_PAID y bodega ya no lo carga).
  asignadoAId Int?      @map("asignado_a_id")
  asignadoAt  DateTime? @map("asignado_at")

  // Asignación a cajero (monitor de ventanillas). Sólo aplica a pedidos KIOSKO en PENDING_PAID.
  // 1:1 con el usuario Cajero logueado — no hay tabla Ventanilla, cada Cajero ES su ventanilla.
  cajeroAsignadoId Int?      @map("cajero_asignado_id")
  cajeroAsignadoAt DateTime? @map("cajero_asignado_at")

  // F12 (sep 2026): reloj de atención del bodeguero. La urgencia de un pedido
  // mide cuánto tiempo lleva en MANOS del bodeguero, no el tiempo total desde
  // que se creó. El reloj se PAUSA mientras la pelota está del lado del cliente
  // (WAITING_CUSTOMER_APPROVAL) y se REANUDA cuando el cliente responde y vuelve
  // a ser tarea del bodeguero.
  //
  //   tiempoAtencionBodegaMs: tiempo acumulado en manos del bodeguero (ms).
  //   bodegaTurnoDesdeAt:     cuándo empezó el turno actual del bodeguero.
  //                           NULL = el reloj está pausado (esperando al cliente).
  //
  // El tiempo "en manos del bodeguero" en un instante T es:
  //   tiempoAtencionBodegaMs + (bodegaTurnoDesdeAt ? T - bodegaTurnoDesdeAt : 0)
  tiempoAtencionBodegaMs Int       @default(0) @map("tiempo_atencion_bodega_ms")
  bodegaTurnoDesdeAt     DateTime? @map("bodega_turno_desde_at")

  // F13 (sep 2026): cuándo el cliente pidió un asesor de ventas desde una
  // propuesta de bodega. NULL = nunca lo pidió. El pedido pasa a EN_ASESORIA
  // y entra a la cola de VENTAS de su tienda (que es 1 por tienda, sin
  // asignación 1:1 — no hay vendedorAsignadoId).
  asesorSolicitadoAt  DateTime? @map("asesor_solicitado_at")
  // F13: nota libre del cliente al pedir asesor (qué quiere negociar).
  asesorSolicitudNota String?   @map("asesor_solicitud_nota") @db.Text

  // PR7 (sep 2026): aviso de "el cliente ya está en tienda" para pedidos
  // web que se recogerán en mostrador. Es una señal de cola, NO un
  // estado del pedido (puede ocurrir en REVIEWING, PENDING_PAID, PAID,
  // SHIPPED, etc.). Decisión: columnas y no estado, porque es ortogonal
  // al ciclo de vida. Ver kiosko-llegada.service.ts para el flujo.
  //
  // - llegadaAnunciadaAt: PRIMER aviso (mide espera real del cliente).
  // - llegadaUltimoAvisoAt: ÚLTIMO aviso (frescura del badge en mostrador).
  // - llegadaAnunciadaCount: cuántos avisos lleva (anti-spam).
  // - llegadaAnunciadaCanal: QR | FOLIO | WEB | MOSTRADOR.
  // - llegadaAnunciadaKioskoId: si vino del kiosko, qué kiosko.
  // - llegadaAnunciadaPor: snapshot del nombre del kiosko u operador
  //   (NO FK: si el kiosko se borra, el texto sigue legible para
  //   auditoría).
  // - llegadaDescartadaAt + PorId: cuando el mostrador descarta un
  //   aviso falso (cliente se fue sin recoger, etc.).
  llegadaAnunciadaAt       DateTime?     @map("llegada_anunciada_at")
  llegadaUltimoAvisoAt     DateTime?     @map("llegada_ultimo_aviso_at")
  llegadaAnunciadaCount    Int           @default(0) @map("llegada_anunciada_count")
  llegadaAnunciadaCanal    CanalLlegada? @map("llegada_anunciada_canal")
  llegadaAnunciadaKioskoId Int?          @map("llegada_anunciada_kiosko_id")
  llegadaAnunciadaPor      String?       @map("llegada_anunciada_por") @db.VarChar(60)
  llegadaDescartadaAt      DateTime?     @map("llegada_descartada_at")
  llegadaDescartadaPorId   Int?          @map("llegada_descartada_por_id")

  // F15 (sep 2026): marcas de agua de lectura del chat (modelo WhatsApp/Telegram).
  //   * Por LADO, no por usuario (hay UN asesor por tienda, así que "tienda leyó" es la
  //     unidad correcta; si algún día hay varios asesores por tienda, migrar a una tabla
  //     PedidoChatLectura con (userId, pedidoId, ultimoMensajeLeidoId)).
  //   * Por ID de mensaje, no por timestamp: id es autoincrement monótono y clock-free;
  //     timestamp(3) tiene colisiones de ms y deriva entre instancias. Comparar
  //     `m.id <= watermark` es O(1) y estable sin importar el reloj.
  //
  // cliente_ultimo_mensaje_entregado_id: el cliente recibió el último eco del socket.
  //   No se persiste via REST; el cliente lo bumpea al recibir el eco, idempotente.
  // cliente_ultimo_mensaje_leido_id: el cliente abrió el detalle con foco, persistido via REST.
  // tienda_ultimo_mensaje_leido_id: alguien del lado tienda abrió el detalle con foco.
  clienteUltimoMensajeEntregadoId Int? @map("cliente_ultimo_mensaje_entregado_id")
  clienteUltimoMensajeLeidoId     Int? @map("cliente_ultimo_mensaje_leido_id")
  tiendaUltimoMensajeLeidoId      Int? @map("tienda_ultimo_mensaje_leido_id")

  // Timestamps
  fechaPedido DateTime  @default(now()) @map("fecha_pedido")
  // Lo rellena el webhook del sistema externo (Firebird) al confirmar el cobro,
  // o el admin manualmente como herramienta de soporte.
  fechaPago   DateTime? @map("fecha_pago")

  // Relaciones
  usuario              Usuario                  @relation("PedidoCliente", fields: [usuarioId], references: [id])
  tienda               Tienda                   @relation(fields: [tiendaId], references: [id])
  kiosko               Kiosko?                  @relation("PedidoKioskoOrigen", fields: [kioskoId], references: [id], onDelete: SetNull)
  // PR7 (sep 2026): kiosko que AVISÓ la llegada (no necesariamente el
  // kiosko que creó el pedido). Cuando llega vía el kiosko del cliente,
  // esta FK se popula; cuando llega por web/app, queda null.
  kioskoLlegada        Kiosko?                  @relation("PedidoKioskoLlegada", fields: [llegadaAnunciadaKioskoId], references: [id], onDelete: SetNull)
  asignadoA            Usuario?                 @relation("PedidoBodeguero", fields: [asignadoAId], references: [id], onDelete: SetNull)
  cajeroAsignado       Usuario?                 @relation("PedidoCajero", fields: [cajeroAsignadoId], references: [id], onDelete: SetNull)
  llegadaDescartadaPor Usuario?                 @relation("PedidoLlegadaDescartada", fields: [llegadaDescartadaPorId], references: [id], onDelete: SetNull)
  items                ItemPedido[]
  historial            HistorialPedido[]
  actividades          LogActividad[]
  propuestas           PedidoPropuesta[]
  mensajes             PedidoMensaje[]
  notificaciones       Notificacion[]
  mensajeEnviado       MensajeBodegueroEnviado?
  // F9 (ago 2026): cola de envío hacia Firebird. 1:1 con Pedido.
  pendienteEnvio       PedidoPendienteEnvio?
  // F13 (sep 2026): lista de reposición. 1:1 con Pedido, sólo existe si el
  // pedido se canceló por rechazo del cliente (los productos vuelven al anaquel).
  reposicion           PedidoReposicion?

  @@index([tiendaId, estado])
  @@index([usuarioId])
  @@index([cajeroAsignadoId])
  @@index([estado, canalOrigen])
  @@index([asignadoAId])
  @@index([kioskoId])
  // PR7 (sep 2026): mostrar pedidos con aviso de llegada primero,
  // FIFO entre los que llevan más tiempo esperando. El WHERE se
  // implementa como índice parcial en la migración SQL porque
  // Prisma no soporta @@index.where.
  @@index([tiendaId, llegadaAnunciadaAt])
  @@map("pedidos")
}

model ItemPedido {
  id               Int     @id @default(autoincrement())
  pedidoId         Int     @map("pedido_id")
  productoId       Int     @map("producto_id")
  precioCOId       Int?    @map("precioco_id") // Opcional: SetNull si PrecioCO se borra (snapshot guarda todo)
  cantidad         Int
  precioUnitario   Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal         Decimal @db.Decimal(12, 2)
  // Sincronización bidireccional (F9+): snapshot de la cantidad que tenía el
  // item al crear el pedido. Se compara contra la nueva cantidad que reporta
  // MOVPED para distinguir COMPLETO (igual), PARCIAL (menor) o NO_DISPONIBLE (0).
  cantidadOriginal Int     @default(0) @map("cantidad_original")

  // Snapshot de los datos (no cambia aunque el producto/variante cambien)
  productoNombre String @map("producto_nombre") @db.VarChar(150)
  productoCodigo String @map("producto_codigo") @db.VarChar(50)
  corridaNombre  String @map("corrida_nombre") @db.VarChar(50)
  tallaNombre    String @map("talla_nombre") @db.VarChar(10)
  colorNombre    String @map("color_nombre") @db.VarChar(30)

  // B2B: flags para auditoría de revisión
  original  Boolean @default(true) // false = agregado por revisión aceptada
  cancelada Boolean @default(false) // true = rechazado en revisión o cancelado por bodega

  // Surtido en bodega: track de qué encontró el bodeguero vs qué pidió el cliente
  cantidadSurtida Int           @default(0) @map("cantidad_surtida")
  estadoSurtido   EstadoSurtido @default(PENDIENTE) @map("estado_surtido")
  surtidoAt       DateTime?     @map("surtido_at")

  // B2B surtido B2.6: motivo textual del bodeguero al marcar el item
  // (ej. "No hay talla M", "Sólo hay 2 piezas"). Se propaga al PedidoRevisionItem.motivo
  // al confirmarSurtido si hay faltante. Nullable: items sin tocar no tienen motivo.
  motivoSurtido String? @map("motivo_surtido") @db.Text

  // B2B surtido B2.6: si el bodeguero eligió una variante sustituta (otra talla/color u
  // otro producto) desde la quick option, se guarda aquí el PrecioCO propuesto. Al
  // confirmarSurtido genera una PedidoRevisionItem con nuevoPrecioCOId para que el
  // cliente apruebe. SetNull si el PrecioCO se elimina (snapshot guarda todos los demás
  // datos en productoNombre/codigo/talla/color).
  sustitucionPropuestaPrecioCOId Int?      @map("sustitucion_propuesta_precioco_id")
  sustitucionPropuesta           PrecioCO? @relation("SustitucionPropuesta", fields: [sustitucionPropuestaPrecioCOId], references: [id], onDelete: SetNull)

  // Relaciones
  pedido   Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto        @relation(fields: [productoId], references: [id])
  precioCO PrecioCO?       @relation(fields: [precioCOId], references: [id], onDelete: SetNull)
  mensajes PedidoMensaje[]

  @@index([pedidoId, cancelada])
  @@map("items_pedido")
}

// F12 (sep 2026): propuesta de ajuste que bodega envía al cliente cuando
// faltan productos. Reemplaza el flujo formal de revisión (PedidoRevision)
// por una negociación vía chat con un modelo verificable server-side.
//
// La propuesta se ATA AL PEDIDO, no al bodeguero: si el bodeguero la libera
// a la cola, la propuesta persiste y la respuesta del cliente se aplica al
// pedido sin importar quién esté asignado.
//
// `items` es un JSON con la propuesta completa (mismo shape que el frontend
// `lib/propuesta.ts`): array de { itemId, tipo, producto, variante, cantidad,
// precioUnitario, subtotal, ... }. Se guarda como snapshot para que la
// propuesta no cambie aunque el pedido/items cambien después.
//
// F13 (sep 2026): la propuesta puede venir de BODEGA (solo hay todo/menos/no
// hay) o de VENTAS (puede cambiar productos, cantidades y variantes). Las
// decisiones legales del cliente dependen del origen — ver
// `creadaPorRol` y `PropuestaService`.
model PedidoPropuesta {
  id           Int             @id @default(autoincrement())
  pedidoId     Int             @map("pedido_id")
  estado       EstadoPropuesta @default(PENDIENTE)
  items        Json            @db.Json
  total        Decimal         @db.Decimal(12, 2)
  // Nota libre del bodeguero que acompaña la propuesta (ej. "Sólo hay 2 piezas").
  nota         String?         @db.Text
  creadaPorId  Int             @map("creada_por_id")
  // F13: snapshot del rol del autor (mismo patrón que PedidoMensaje.autorRol).
  // Determina qué decisiones puede tomar el cliente: una propuesta de BODEGA
  // admite CONTACTAR_ASESOR; una de VENTAS admite CANCELAR_PEDIDO.
  creadaPorRol RolUsuario      @default(BODEGA) @map("creada_por_rol")
  enviadaAt    DateTime        @default(now()) @map("enviada_at")
  // Cuándo el cliente respondió (aceptó o rechazó). NULL = aún pendiente.
  respondidaAt DateTime?       @map("respondida_at")
  // F13 (sep 2026): cuándo bodega CONSUMIÓ esta propuesta aceptada al cerrar
  // el surtido. Sin esto, una propuesta ACEPTADA en la ronda 1 autorizaría
  // faltantes de la ronda 2 sin que el cliente los haya aprobado (el bug de
  // loop: `confirmarSurtido` busca la última ACEPTADA sin importar si ya se
  // aplicó). `confirmarSurtido` exige `consumidaAt IS NULL`.
  consumidaAt  DateTime?       @map("consumida_at")
  // F12: nota del cliente al responder (ej. motivo del rechazo). Se guarda
  // aquí para que el bodeguero la vea en el historial de propuestas.
  notaCliente  String?         @map("nota_cliente") @db.Text
  // Si el admin forzó la aprobación sin respuesta del cliente, se registra aquí.
  forzadaPorId Int?            @map("forzada_por_id")
  forzadaAt    DateTime?       @map("forzada_at")

  // Relaciones
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  creadaPor  Usuario  @relation("PropuestaCreador", fields: [creadaPorId], references: [id])
  forzadaPor Usuario? @relation("PropuestaForzador", fields: [forzadaPorId], references: [id])

  // F13: índice único PARCIAL sobre (pedidoId) WHERE estado = 'PENDIENTE'.
  // No se puede declarar en Prisma (no soporta índices parciales) — vive en
  // la migración SQL. Cierra la carrera del "no apilar PENDIENTES": ahora que
  // BODEGA y VENTAS pueden proponer sobre el mismo pedido, dos envíos
  // concurrentes crearían dos PENDIENTES y la segunda quedaría zombi.
  @@index([pedidoId, estado])
  @@map("pedidos_propuestas")
}

model PedidoMensaje {
  id                 Int        @id @default(autoincrement())
  pedidoId           Int        @map("pedido_id")
  itemId             Int?       @map("item_id")
  autorId            Int        @map("autor_id")
  autorRol           RolUsuario @map("autor_rol")
  contenido          String     @db.Text
  visibleParaCliente Boolean    @default(true) @map("visible_para_cliente")
  createdAt          DateTime   @default(now()) @map("created_at")
  // F13 (sep 2026): adjuntos del mensaje. Modelo discriminado por `tipo`:
  // - { tipo: 'propuesta', propuestaId: number } para mensajes que viajan
  //   junto a una propuesta (estilo WhatsApp/Airbnb).
  // La columna es JSONB sin CHECK para no romper migraciones futuras; la
  // validación del discriminador vive en el DTO del backend.
  // Sin @db.Json a propósito: el default de Prisma en PostgreSQL es jsonb,
  // que es lo que la columna realmente es (y lo deseable: indexable).
  adjunto            Json?      @map("adjunto")

  // Relaciones
  pedido         Pedido                    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item           ItemPedido?               @relation(fields: [itemId], references: [id], onDelete: SetNull)
  autor          Usuario                   @relation(fields: [autorId], references: [id])
  mensajeEnviado MensajeBodegueroEnviado[]

  @@index([pedidoId, createdAt])
  @@index([itemId])
  @@map("pedidos_mensajes")
}

// F8 (jul 2026): marca que ya se envió el email de "primera respuesta del
// bodeguero" para este pedido. Garantiza que sólo se manda UNA vez por
// pedido aunque el bodeguero intercambie varios mensajes en el chat.
// pedidoId es PK (un pedido -> máximo un email de este tipo).
model MensajeBodegueroEnviado {
  pedidoId  Int      @id @map("pedido_id")
  mensajeId Int      @map("mensaje_id")
  enviadoAt DateTime @default(now()) @map("enviado_at")

  pedido  Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  mensaje PedidoMensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@map("mensaje_bodeguero_enviado")
}

// ComprobantePago eliminado en refactor de pagos fuera del sistema (jun 2026).
// El cobro se realiza en un sistema externo (Visual FoxPro + Firebird) que
// notifica al backend vía webhook (`POST /pedidos/admin/:id/marcar-pagado`,
// autenticado por X-Agent-Key). No reintroducir este modelo sin antes evaluar
// si el sistema externo va a generar sus propios recibos.

model Notificacion {
  id           Int               @id @default(autoincrement())
  pedidoId     Int?              @map("pedido_id")
  canal        CanalNotificacion
  tipo         TipoNotificacion
  destinatario String            @db.VarChar(200)
  payload      Json?
  exitosa      Boolean           @default(false)
  errorMsg     String?           @map("error_msg") @db.Text
  enviadaAt    DateTime          @default(now()) @map("enviada_at")

  // Relaciones
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([enviadaAt])
  @@map("notificaciones")
}

// ==================== HISTORIAL Y AUDITORÍA ====================

model HistorialPedido {
  id             Int           @id @default(autoincrement())
  pedidoId       Int           @map("pedido_id")
  estadoAnterior EstadoPedido? @map("estado_anterior")
  estadoNuevo    EstadoPedido  @map("estado_nuevo")
  observacion    String?       @db.Text
  usuarioId      Int?          @map("usuario_id")
  usuarioNombre  String?       @map("usuario_nombre") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at")

  // Relaciones
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("historial_pedidos")
}

model LogActividad {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?     @map("usuario_id")
  pedidoId    Int?     @map("pedido_id")
  accion      String   @db.VarChar(50)
  descripcion String   @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  pedido  Pedido?  @relation(fields: [pedidoId], references: [id])

  @@index([usuarioId])
  @@index([pedidoId])
  @@index([createdAt])
  @@map("log_actividades")
}

// ==================== KIOSKOS ====================

// Un kiosko representa una tablet física en una tienda. El cliente que
// llega usa SU propia cuenta (no hay cuenta kiosko compartida). El kiosko
// sólo aporta trazabilidad: cada pedido guardará kioskoId para que el
// cliente vea en su historial "Pedido X hecho en kiosko Y, tienda Z".
model Kiosko {
  id                  Int          @id @default(autoincrement())
  tiendaId            Int          @map("tienda_id")
  nombre              String       @db.VarChar(50) // ej: "Kiosko Entrada", "Kiosko 1"
  estado              EstadoKiosko @default(ACTIVO)
  activadoAt          DateTime     @default(now()) @map("activado_at")
  activadoPorId       Int          @map("activado_por_id")
  desactivadoAt       DateTime?    @map("desactivado_at")
  desactivadoPorId    Int?         @map("desactivado_por_id")
  // Heartbeat desde la tablet cada 60s. NULL = kiosko nunca reportado
  // (recién activado) o tablet apagada. La UI admin usa esto para alertar.
  ultimoHeartbeat     DateTime?    @map("ultimo_heartbeat")
  // Se setea en el primer heartbeat que activa el kiosko (transición
  // INACTIVO → ACTIVO). NULL = la tablet nunca se conectó.
  // La UI admin usa esto para distinguir "Inactivo · pendiente de conectar"
  // (estado=INACTIVO + primerConexionAt IS NULL) vs "Inactivo · desactivado"
  // (estado=INACTIVO + primerConexionAt IS NOT NULL).
  primerConexionAt    DateTime?    @map("primer_conexion_at")
  // PR2 (kiosko-profesional, sep 2026): identidad de dispositivo.
  // Hash SHA-256 del token que el admin pega en la tablet al activarla.
  // Se exige vía header `X-Kiosko-Token` en heartbeat y en crear pedido
  // para impedir spoofing de X-Kiosko-Id (que es SERIAL y enumerable).
  // El token en claro NUNCA se persiste — solo se retorna al admin una vez.
  // NULL = kiosko activado antes de este cambio (legacy); el admin debe
  // regenerar para que el dispositivo pueda operar.
  deviceTokenHash     String?      @unique @map("device_token_hash") @db.VarChar(64)
  deviceTokenCreadoAt DateTime?    @map("device_token_creado_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relaciones
  tienda          Tienda          @relation(fields: [tiendaId], references: [id])
  activadoPor     Usuario         @relation("KioskoActivador", fields: [activadoPorId], references: [id])
  desactivadoPor  Usuario?        @relation("KioskoDesactivador", fields: [desactivadoPorId], references: [id])
  pedidos         Pedido[]        @relation("PedidoKioskoOrigen")
  // PR7 (sep 2026): pedidos donde ESTE kiosko anunció la llegada (no
  // donde se crearon).
  pedidosLlegada  Pedido[]        @relation("PedidoKioskoLlegada")
  emparejamientos KioskoPairing[]

  @@unique([tiendaId, nombre])
  @@index([tiendaId, estado])
  @@map("kioskos")
}

/// Emparejamiento de una tablet con un kiosko.
///
/// Resuelve el caso en que la tablet PERDIÓ su credencial (actualización de la
/// app, borrado de almacenamiento, reinstalación). El personal de tienda no
/// puede recuperarla por su cuenta — no puede navegar a ajustes ni borrar
/// datos — así que la recuperación es remota:
///
///   1. La tablet (sin credencial) pide un emparejamiento y muestra un CÓDIGO
///      de 6 dígitos en su pantalla.
///   2. El encargado lee el código al admin; el admin lo teclea en su panel.
///   3. El admin autoriza y elige a qué kiosko pertenece esa tablet.
///   4. La tablet reclama el token y se configura sola.
///
/// SEGURIDAD — el código NO es la credencial. Un código de 6 dígitos es
/// adivinable y además es audible/visible (cualquiera en la tienda puede
/// leerlo). Lo que AUTORIZA el reclamo es `deviceSecretHash`: un secreto que la
/// tablet genera y NUNCA sale de su memoria. El código sólo sirve para que el
/// admin correlacione la solicitud con la tablet que tiene enfrente.
///
/// El código en claro nunca se persiste (sólo su SHA-256), igual que el device
/// token.
model KioskoPairing {
  id               String              @id @default(cuid())
  /// SHA-256 del código de 6 dígitos. Único mientras está vivo.
  codeHash         String              @unique @map("code_hash") @db.VarChar(64)
  /// SHA-256 del secreto que genera la tablet. Es lo que autoriza el reclamo.
  deviceSecretHash String              @map("device_secret_hash") @db.VarChar(64)
  estado           KioskoPairingEstado @default(PENDIENTE)

  /// Pistas que la tablet conoce de sí misma (no son secretos, no autorizan).
  tiendaIdHint Int? @map("tienda_id_hint")
  kioskoIdHint Int? @map("kiosko_id_hint")

  /// Kiosko al que el admin autorizó vincular esta tablet.
  kioskoId Int?    @map("kiosko_id")
  kiosko   Kiosko? @relation(fields: [kioskoId], references: [id], onDelete: Cascade)

  /// Auditoría: quién autorizó y cuándo.
  aprobadoPorId Int?      @map("aprobado_por_id")
  aprobadoPor   Usuario?  @relation("KioskoPairingAprobador", fields: [aprobadoPorId], references: [id])
  aprobadoAt    DateTime? @map("aprobado_at")
  reclamadoAt   DateTime? @map("reclamado_at")

  /// Intentos fallidos de canje. Se cuentan POR CÓDIGO (no por IP): un
  /// atacante con varias IPs no puede multiplicar sus intentos, y 5 fallos
  /// queman ese código vengan de donde vengan.
  intentosFallidos Int @default(0) @map("intentos_fallidos")

  /// Contexto para que el admin reconozca la solicitud (no autoriza nada).
  ipPrimeraVista String? @map("ip_primera_vista") @db.VarChar(64)
  userAgent      String? @map("user_agent") @db.VarChar(255)

  expiraAt  DateTime @map("expira_at")
  createdAt DateTime @default(now()) @map("created_at")
  /// Se actualiza con cada cambio de estado. Permite retener un tiempo las
  /// filas terminales (RECLAMADO, CANCELADO, EXPIRADO) y luego purgarlas.
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado, expiraAt])
  @@index([kioskoId])
  @@index([estado, updatedAt])
  @@map("kiosko_pairings")
}

enum KioskoPairingEstado {
  PENDIENTE
  APROBADO
  RECLAMADO
  EXPIRADO
  CANCELADO
}

// ==================== FAVORITOS ====================

model Favorito {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  productoId Int      @map("producto_id")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, productoId])
  @@index([usuarioId])
  @@map("favoritos")
}

// ==================== PASSWORD RESET ====================

// F8 (jul 2026): tokens de un solo uso para recuperación de contraseña.
// `token` guarda el SHA256 del token random que se manda por email (nunca
// el token en claro). Al usarse se marca usedAt; expirado o usado = inválido.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  token     String    @unique @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipOrigen  String?   @map("ip_origen") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==================== REFRESH TOKENS (F12 ago 2026) ====================
// Rotación + revocación de refresh tokens. Cada refresh emite un token nuevo
// y revoca el anterior; logout revoca todos los del usuario. El token se
// guarda como hash SHA256 (si la BD se filtra, los tokens en claro no están
// expuestos). El `familyId` agrupa la cadena de rotaciones de una sesión:
// si un token de una familia se reutiliza tras ser rotado, se revoca toda
// la familia (detección de robo).
model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  familyId   String    @map("family_id") @db.VarChar(36)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy Int?      @map("replaced_by")
  ipOrigen   String?   @map("ip_origen") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ==================== SINCRONIZACIÓN BIDIRECCIONAL (F9 ago 2026) ====================
// Infraestructura para sincronizar PostgreSQL (nube) con Firebird local
// (DATOSINV.FDB + BANDEJA_SYNC). El agente local corre en el servidor
// central de Firebird y replica cambios en ambos sentidos.

// Mapeo polimórfico entre IDs de la nube (PostgreSQL) y Firebird local.
// Una sola fila = "este entityId en la nube corresponde a este ID local
// en Firebird tienda X". Soporta el caso de un usuario que es cliente en
// varias tiendas (un ExternalRef por tienda).
model ExternalRef {
  id            Int      @id @default(autoincrement())
  systemEntity  String   @db.VarChar(40) // USUARIO|TIENDA|PRODUCTO|CORRIDA|COLOR|TALLA|PRECIO|PRECIOCO|PEDIDO
  systemId      Int // PK en PG
  localEntity   String   @db.VarChar(40) // CLIENTES|CLIENTESCXC|TIENDAS|PRODUCTOS|...
  localId       Int
  localTiendaId Int? // FK lógica a TIENDAS.IDTIENDA. NULL para entidades globales.
  syncedAt      DateTime @default(now()) @map("synced_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([systemEntity, systemId, localEntity, localTiendaId])
  @@index([systemEntity, systemId])
  @@index([localEntity, localId])
  @@index([localEntity, localTiendaId, localId])
  @@map("external_refs")
}

// Watermark por tienda: el agente local guarda aquí el último BANDEJA_SYNC.ID
// que ya subió a la nube. El checkpoint es por tienda (no por instancia
// de agente), para soportar reinstalación del agente sin perder progreso.
model SyncCheckpoint {
  id                Int       @id @default(autoincrement())
  tiendaId          Int       @unique @map("tienda_id")
  ultimoBANDEJAId   BigInt    @default(0) @map("ultimo_bandeja_id")
  ultimoHeartbeatAt DateTime? @map("ultimo_heartbeat_at")
  agentVersion      String?   @map("agent_version") @db.VarChar(20)
  lastError         String?   @map("last_error") @db.Text
  lastErrorAt       DateTime? @map("last_error_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@map("sync_checkpoints")
}

// Cola de pedidos NUEVOS nube→Firebird. Cuando ClienteService.crearPedido
// genera un pedido, también inserta aquí un registro. El agente lo sondea,
// lo baja a Firebird via GRABAR_PEDIDOS + GRABAR_MOVPED, y al terminar
// hace ack cambiando estado a PROCESADO con externalIdPEDIDOS.
model PedidoPendienteEnvio {
  id                Int       @id @default(autoincrement())
  pedidoId          Int       @unique @map("pedido_id")
  estado            String    @default("PENDIENTE") @db.VarChar(20)
  // PENDIENTE → PROCESSING → PROCESADO; RETRY vuelve a ser elegible.
  intentos          Int       @default(0)
  claimedBy         String?   @map("claimed_by") @db.VarChar(100)
  leaseToken        String?   @map("lease_token") @db.VarChar(80)
  leaseUntil        DateTime? @map("lease_until")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at")
  ultimoError       String?   @map("ultimo_error") @db.Text
  ultimoIntentoAt   DateTime? @map("ultimo_intento_at")
  ultimoErrorCode   String?   @map("ultimo_error_code") @db.VarChar(60)
  // IDPEDIDO en Firebird devuelto por GRABAR_PEDIDOS. Permite idempotencia
  // en reintentos: si el agente crashea entre el INSERT y el ack, al
  // reintentar usa este ID en lugar de generar uno nuevo.
  externalIdPEDIDOS Int?      @map("external_id_pedidos")
  externalFolio     String?   @map("external_folio") @db.VarChar(10)
  createdAt         DateTime  @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([estado, createdAt])
  // Restaurados (F9 ago 2026): estos índices los creó la migración 2210 pero
  // el schema los había perdido. Sin ellos el poll-pedidos hace seq scan sobre
  // pedidos_pendientes_envio cuando crece.
  @@index([estado, nextAttemptAt, leaseUntil], map: "pedidos_pendientes_envio_claim_idx")
  @@index([leaseToken], map: "pedidos_pendientes_envio_lease_token_idx")
  // PR7 (sep 2026): índice en externalFolio para que la búsqueda de
  // kiosko-llegada no haga seq scan cuando crezca el histórico.
  @@index([externalFolio])
  @@map("pedidos_pendientes_envio")
}

// F13 (sep 2026): lista de reposición de bodega.
//
// Cuando el cliente RECHAZA una propuesta, el pedido se cancela y los
// productos que bodega ya había apartado tienen que volver físicamente al
// anaquel. Como el modelo B2B NO maneja inventario (el modelo Stock se
// eliminó en el refactor B2B — ver el comentario sobre PrecioCO), esto NO es
// un contador que se suma: es una lista de trabajo para bodega con
// confirmación humana.
//
// 1:1 con Pedido (pedidoId es @unique). Sólo existe si el pedido se canceló
// por rechazo del cliente; una cancelación desde Firebird (SWCANCEL) no la
// crea, porque en ese caso el ERP ya sabe que el pedido murió.
model PedidoReposicion {
  id            Int              @id @default(autoincrement())
  pedidoId      Int              @unique @map("pedido_id")
  estado        EstadoReposicion @default(PENDIENTE)
  // Snapshot de los items a reponer (mismo shape que ItemPedido relevante:
  // productoNombre, productoCodigo, tallaNombre, colorNombre, corridaNombre,
  // cantidad). Se guarda como snapshot para que la lista no cambie aunque el
  // pedido o sus items se modifiquen después.
  items         Json             @db.Json
  // Por qué se canceló (texto del cliente al rechazar, o motivo del sistema).
  motivo        String?          @db.Text
  creadaAt      DateTime         @default(now()) @map("creada_at")
  repuestoAt    DateTime?        @map("repuesto_at")
  repuestoPorId Int?             @map("repuesto_por_id")

  // Relaciones
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  repuestoPor Usuario? @relation("ReposicionReponedor", fields: [repuestoPorId], references: [id], onDelete: SetNull)

  @@index([estado, creadaAt])
  @@map("pedidos_reposicion")
}

// Auditoría bidireccional: cada evento de sync (cambio procesado, error,
// ack, heartbeat) deja un rastro para debugging desde panel admin.
model SyncEventInbox {
  id              Int       @id @default(autoincrement())
  eventId         String    @unique @map("event_id") @db.VarChar(160)
  tiendaId        Int       @map("tienda_id")
  bandejaId       BigInt?   @map("bandeja_id")
  entidad         String    @db.VarChar(40)
  operacion       String    @db.VarChar(1)
  localId         Int       @map("local_id")
  estado          String    @default("PROCESANDO") @db.VarChar(20)
  intentos        Int       @default(0)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at")
  ultimoErrorCode String?   @map("ultimo_error_code") @db.VarChar(60)
  payload         Json
  mensaje         String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  // Relación con Tienda (F9 ago 2026): la migración 2211 creó el FK en BD
  // pero el schema nunca declaró la relación. Sin esto, Prisma cree que
  // tiendaId es huérfano y borra el constraint en migrate dev.
  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, createdAt])
  @@index([estado, createdAt])
  // Restaurado (F9 ago 2026): la migración 2213 lo creó pero el schema lo perdió.
  @@index([estado, nextAttemptAt], map: "sync_event_inbox_retry_idx")
  @@map("sync_event_inbox")
}

model SyncEventLog {
  id          Int      @id @default(autoincrement())
  tiendaId    Int?     @map("tienda_id")
  direccion   String   @map("direccion") @db.VarChar(10) // UP | DOWN
  tipo        String   @map("tipo") @db.VarChar(20) // CATALOGO|CLIENTE|PEDIDO|PAGO|HEARTBEAT
  referencia  String?  @map("referencia") @db.VarChar(100)
  exitoso     Boolean  @default(true)
  mensaje     String?  @db.Text
  payloadSize Int?     @map("payload_size")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tiendaId, createdAt])
  @@index([tipo, exitoso, createdAt])
  @@map("sync_event_log")
}

// Outbox de eventos realtime (Socket.IO). Cada evento que se emite a un room
// se persiste aquí ANTES de emitir en vivo. Si el proceso muere entre el
// persist y el emit, la fila queda con `emitidoAt = null` y el worker
// (RealtimeOutboxWorker) la re-emite al arrancar. `emitidoAt` se setea a now
// en el flujo normal (ya emitido en vivo), así el worker solo re-emite los
// huérfanos. Retención: 1h (el worker borra lo más viejo).
model RealtimeEventOutbox {
  id        Int       @id @default(autoincrement())
  room      String    @db.VarChar(100) // 'tienda-1' | 'pedido-5' | 'user-3' | 'admin:all'
  evento    String    @db.VarChar(60) // 'pedido.creado', 'pedido.estado', ...
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  emitidoAt DateTime? @map("emitido_at") // null = pendiente de re-emitir

  @@index([room, createdAt])
  @@index([emitidoAt])
  @@map("realtime_event_outbox")
}

// Configuración editable desde el panel ADMIN (clave → valor). Singleton por
// `clave`. Hoy solo se usa para el logo de los correos; el patrón permite
// añadir más ajustes sin migración nueva.
//
// `valor` guarda una KEY de storage (p.ej. `branding/logo/uuid.png`), no una
// URL: el borde de la API la resuelve con StorageService, así cambiar de
// bucket o a un CDN no requiere migrar datos.
model ConfiguracionSitio {
  id        Int      @id @default(autoincrement())
  clave     String   @unique @db.VarChar(50)
  // PR5 (kiosko-profesional): ahora TEXT para soportar JSON arrays de
  // keys S3 (kiosko_idle_media con varias imágenes). El logo individual
  // cabe en 500, pero un array de keys no.
  valor     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configuracion_sitio")
}
