generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl sólo se usa para migraciones/DDL. En Neon apunta al endpoint
  // SIN pooler (PgBouncer no soporta DDL); en local es idéntico a url.
  // Prisma EXIGE que la variable exista aunque su valor sea igual a url:
  // si falta, el CLI aborta con "Environment variable not found".
  // Ambas deben apuntar a la MISMA base — ver .env.
  directUrl = env("DIRECT_DATABASE_URL")
}

// PR7 (sep 2026): canal por el que se anunció la llegada a tienda. Es
// ORTOGONAL al estado del pedido (la llegada puede ocurrir en cualquier
// estado). Ver Pedido.llegadaAnunciadaAt.
enum CanalLlegada {
  QR
  FOLIO
  WEB
  MOSTRADOR
}

// ==================== ENUMS ====================

enum RolUsuario {
  CLIENTE
  BODEGA
  BODEGA_MONITOR
  CAJERO
  CAJERO_MONITOR
  MOSTRADOR
  // F16 (sep 2026): TV de la pared del mostrador. Solo LEE la cola y muestra
  // la alerta cuando el operador manda a llamar a un cliente — no puede
  // liberar, ajustar ni cancelar. Por eso es un rol propio y no reusa
  // MOSTRADOR: la pantalla de pared no debe tener permisos de operador.
  MOSTRADOR_MONITOR
  // F13 (sep 2026): asesor de ventas. Uno por tienda, SIN asignación 1:1 —
  // ve la cola de pedidos que el cliente escaló desde una propuesta de bodega.
  // Tiene el chat con el cliente (el bodeguero ya no lo tiene) y arma la
  // contrapropuesta de productos, cantidades y variantes.
  VENTAS
  // Oct 2026 (pagos por transferencia): verifica que las transferencias de TODAS las tiendas
  // sí llegaron al banco. Multi-tienda: NO tiene `tiendaId`. No cobra, no marca pagado y no
  // cambia el estado de ningún pedido: el cobro sigue siendo de VFP. Ver PLAN-PAGOS-TRANSFERENCIA.md.
  TESORERIA
  // Oct 2026 (impresión DTF): revisa los archivos de los clientes, pide correcciones, imprime y
  // marca listo. Tiene `tiendaId` (varias personas por tienda). Ver PLAN-DTF.md.
  IMPRESION
  // Oct 2026 (17-oct, decisión del dueño): gerente de UNA tienda (con `tiendaId`, como el resto de
  // empleados). Supervisa su tienda: torre de control, salud y búsqueda de pedidos; las acciones para
  // destrabar pedidos llegan después. NO entra a Tesorería, a las consolas operativas ni a /admin; lo que
  // solo hace el ADMIN (marcar gratis, cancelar pagados, cambiar precios, crear empleados) sigue siéndolo
  // porque `RolesGuard` niega por defecto: GERENTE solo está donde se le nombra (ver `roles-contrato.spec`).
  GERENTE
  ADMIN
}

// F17 (oct 2026): los 8 procesos del negocio, con los nombres del negocio.
//
// Antes el enum tenía nombres técnicos y el negocio hablaba de otra cosa
// ("área de entrega", "mesa", "revisado"), así que código y pantalla decían distinto.
// Ahora dicen lo mismo. El estado NO se persiste en Firebird (el agente lee el
// campo pero no lo usa para nada), así que el renombrado no toca la
// sincronización.
//
//   1 SOLICITADO            el cliente lo creó. En cola de bodega.
//   2 EN_REVISION           un bodeguero lo tomó y lo está surtiendo.
//   3 REVISADO              el ÁREA DE ENTREGA. El bodeguero cerró el surtido —completo
//                           o incompleto— y la bolsa con el ticket está en la
//                           mesa de mostrador. Si hay faltantes, el sistema ya
//                           mandó la propuesta y el cliente debe decidir.
//   4 EN_ATENCION           el operador llamó al cliente y está haciendo el
//                           recuento con él, enfrente.
//   5 PENDIENTE_PAGO        se envió a pagar. AQUÍ entra al ERP.
//   6 PAGADO                cobrado en VFP.
//   7 (listo para entregar) PAGADO sin domicilio: el operador entrega.
//   8 ENTREGADO             cerrado.
//
// Domicilio: PAGADO → ENVIADO → ENTREGADO.
enum EstadoPedido {
  SOLICITADO
  EN_REVISION
  // F13 (sep 2026): el cliente pidió un asesor de ventas, o rechazó la
  // propuesta del vendedor y quiere re-negociar. El pedido sale de la cola
  // de bodega y entra a la cola de VENTAS de su tienda.
  EN_ASESORIA
  // F13: el cliente debe decidir sobre una propuesta. Estado PROPIO (y no
  // REVISADO) porque el pedido todavía no puede mostrarse: hay faltantes sin
  // resolver y mostrador no tiene nada que enseñar. Sale de aquí cuando el
  // cliente responde (aprobar → REVISADO, rechazar → CANCELADO, asesor →
  // EN_ASESORIA).
  //
  // OJO: este es el único camino que NO pasa por el área de entrega. El cierre de
  // surtido normal (SurtidoService.confirmarSurtido) manda a REVISADO incluso
  // con faltantes, y crea la propuesta ahí mismo.
  ESPERANDO_APROBACION
  // F16 (sep 2026) / F17: EL ÁREA DE ENTREGA. Bodega ya verificó físicamente los
  // productos y el pedido está apartado en la mesa, esperando al cliente.
  //
  // Por qué un estado y no una columna sobre PENDIENTE_PAGO: con una columna,
  // CADA query del cajero tendría que acordarse de filtrarla, y un solo
  // filtro olvidado manda a un cliente a pagar antes de que mostrador le
  // muestre su pedido. Con estado propio, un pedido no liberado es
  // estructuralmente invisible para el pago.
  //
  // Salidas: EN_ATENCION (llamar al cliente),
  //          EN_REVISION  (ajustar — el cliente cambió algo, bodega re-surte),
  //          PENDIENTE_PAGO (enviar a pagar — aquí se encola a Firebird),
  //          CANCELADO    (cancelar + lista de reposición).
  REVISADO
  // F17 (oct 2026): el operador llamó al cliente y lo está atendiendo. Antes
  // esto era la columna `Pedido.llamadoAt`, que no distinguía "llamado" de
  // "atendiendo" y obligaba a cada query a recordar el filtro. Con estado
  // propio, el panel "Atendiendo" de la TV es un WHERE, no un cálculo.
  //
  // Salidas: REVISADO (deshacer la llamada — el cliente no llegó),
  //          EN_REVISION (ajustar durante el recuento),
  //          PENDIENTE_PAGO (enviar a pagar),
  //          CANCELADO.
  EN_ATENCION
  // Oct 2026 (impresión DTF, PLAN-DTF.md D3): el pedido espera a que su DTF esté impreso. El
  // pedido solo-DTF NACE aquí; el mixto llega cuando bodega cierra y aún hay DTF pendiente.
  // Estado propio y no un filtro: ninguna consulta de bodega lo ve (filtran SOLICITADO/EN_REVISION).
  //
  // Salidas: REVISADO (todo impreso; el área de entrega), PENDIENTE_PAGO (solo DOMICILIO, con
  //          encolado a Firebird) y CANCELADO. Desde REVISADO/EN_ATENCION se vuelve aquí si hay
  //          que reimprimir.
  EN_DTF
  PENDIENTE_PAGO
  PAGADO
  ENVIADO
  ENTREGADO
  CANCELADO
}

// F12 (sep 2026): estado de una propuesta de ajuste que bodega envía al
// cliente cuando faltan productos. El pedido pasa a WAITING_CUSTOMER_APPROVAL
// mientras la propuesta está PENDIENTE.
//
// F13 (sep 2026): la semántica de la respuesta cambió. Ya no vuelve a
// REVIEWING a que el bodeguero confirme:
//   - ACEPTAR  → el pedido pasa DIRECTO a PENDING_PAID (bodega ya verificó
//                físicamente lo que propuso, no hay nada que confirmar).
//   - RECHAZAR → el pedido se CANCELA y sus productos entran a la lista de
//                reposición de bodega.
//   - SUPERADA → el cliente pidió un asesor de ventas, así que esta propuesta
//                (de bodega) queda sin efecto y el pedido pasa a EN_ASESORIA.
enum EstadoPropuesta {
  PENDIENTE
  ACEPTADA
  RECHAZADA
  SUPERADA
}

enum CanalOrigen {
  WEB
  KIOSKO
}

// F8 (jul 2026): modo de entrega del pedido. Determina qué datos se requieren
// al crearlo desde el checkout y cómo lo procesa bodega/mostrador.
// - DOMICILIO: requiere dirección + colonia + CP + paquetería (o "admin decide").
// - RECOGER_TIENDA: el cliente recoge en tienda. Sin fecha ni hora programada
//   (se eliminaron en sep 2026: el cliente llega cuando puede).
// - KIOSKO: siempre recoger en tienda. El canalOrigen debe ser KIOSKO.
enum ModoEntrega {
  DOMICILIO
  RECOGER_TIENDA
  KIOSKO
}

// F8 (jul 2026): paqueterías soportadas para envío a domicilio. El cliente
// elige una o, alternativamente, deja que el admin decida (ver
// Pedido.dejarAdminDecidePaqueteria).
enum Paqueteria {
  ALBATROS
  TUFESA
  ESTAFETA
  DHL
  FEDEX
  PAQUETEXPRESS
}

enum CanalNotificacion {
  EMAIL
}

enum TipoNotificacion {
  PEDIDO_RECIBIDO
  // F16 (sep 2026): el pedido quedó apartado en tienda esperando que el cliente
  // lo revise antes de pagar (estado EN_MOSTRADOR). Antes no se notificaba y el
  // cliente debía presentarse en tienda sin haber recibido aviso.
  LISTO_EN_TIENDA
  REVISION_PROPUESTA
  REVISION_APROBADA
  REVISION_RECHAZADA
  PAGO_CONFIRMADO
  ENVIADO
  ENTREGADO
  CANCELADO
  MENSAJE_BODEGUERO
  RESET_PASSWORD
  BIENVENIDA
  // F13 (sep 2026): el cliente pidió un asesor de ventas. Se manda al cliente
  // (confirmación de que alguien lo contactará) y al equipo de ventas.
  ASESOR_SOLICITADO
  // F13: el asesor de ventas envió una contrapropuesta al cliente.
  PROPUESTA_VENTAS
  // F22 (oct 2026): "¿aún quieres tu pedido?". La bolsa lleva días apartada en
  // el área de entrega y el cliente no ha pasado ni avisado. El correo lleva al
  // pedido, donde puede confirmar que sigue interesado o cancelarlo.
  RECORDATORIO_RECOGER
  // Oct 2026 (pagos por transferencia). Ninguno cambia el estado del pedido.
  TRANSFERENCIA_INSTRUCCIONES
  TRANSFERENCIA_COMPROBANTE_RECIBIDO
  TRANSFERENCIA_VERIFICADA
  TRANSFERENCIA_RECHAZADA
  TRANSFERENCIA_REEMBOLSADA
  // Oct 2026 (impresión DTF). El correo de "listo en tienda" del pedido ya cubre el final.
  DTF_RECIBIDO
  DTF_NECESITA_CORRECCION
  DTF_APROBADO
  DTF_RECHAZADO
}

enum EstadoSurtido {
  PENDIENTE // Aún no se ha trabajado este item
  PARCIAL // Se surtió menos de lo pedido (pero algo sí)
  COMPLETO // Se surtió todo lo pedido
  NO_DISPONIBLE // No se pudo surtir nada
}

// F13 (sep 2026): estado de la lista de reposición de bodega. Cuando el
// cliente rechaza una propuesta, los productos del pedido tienen que volver
// físicamente al anaquel. Como el modelo B2B no maneja inventario (el modelo
// Stock se eliminó — ver comentario más abajo), esto es un AVISO OPERATIVO
// con confirmación humana, no un contador que se suma.
enum EstadoReposicion {
  PENDIENTE // Bodega todavía no ha repuesto la mercancía
  REPUESTO // Bodega confirmó que los productos volvieron al anaquel
}

enum EstadoKiosko {
  ACTIVO
  INACTIVO
}

// Oct 2026 (pagos por transferencia). Solo describe la PREFERENCIA del cliente al hacer el
// pedido (`Pedido.metodoPagoPreferido`, no vinculante). Con qué se cobró de verdad lo decide
// VFP y la nube no lo sabe (ver PLAN-PAGOS-TRANSFERENCIA.md §8).
enum MetodoPago {
  EN_TIENDA
  TRANSFERENCIA
}

// Estados de un pago por transferencia. Es una máquina APARTE de `EstadoPedido`: el pedido
// sigue en PENDIENTE_PAGO hasta que VFP lo cobra. Solo hay dinero real desde VERIFICADO.
enum EstadoPagoTransferencia {
  PENDIENTE // instrucciones emitidas, esperando la transferencia
  EN_REVISION // hay un comprobante por revisar
  VERIFICADO // Tesorería vio el abono en el banco
  APLICADO // VFP registró el cobro (el pedido está PAGADO)
  CANCELADO // se cambió a pago en tienda / el pedido murió — sin dinero de por medio
  VENCIDO // caducaron las instrucciones — sin dinero
  REEMBOLSO_PENDIENTE // hubo dinero y hay que devolverlo
  REEMBOLSADO
}

enum EstadoComprobante {
  PENDIENTE
  ACEPTADO
  RECHAZADO
}

// ==================== ENTIDADES CORE ====================

model Tienda {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  direccion  String   @db.VarChar(255)
  ciudad     String   @db.VarChar(50)
  estado     String   @db.VarChar(50)
  telefono   String?  @db.VarChar(20)
  email      String?  @db.VarChar(100)
  activa     Boolean  @default(true)
  // F9 (ago 2026): ID de la tienda en Firebird (TIENDAS.IDTIENDA). Único
  // porque hay una sola BD Firebird central para todas las tiendas y la
  // relación nube↔local es 1:1 por tienda.
  externalId Int?     @unique @map("external_id")
  // Oct 2026 (parte B): las iniciales de la tienda en el Sistema Comercial (TIENDAS.SERIE: HMO, MXL, CUL…). Es el
  // prefijo VISUAL del folio ("HMO-0000152573"). Llega con el catálogo; NULL = aún no sincronizada (se muestra el folio solo).
  serie      String?  @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relaciones
  usuarios         Usuario[]
  usuariosCliente  UsuarioTienda[]
  productosTienda  ProductoTienda[]
  precios          Precio[]
  preciosCO        PrecioCO[]
  pedidos          Pedido[]
  kioskos          Kiosko[]
  // SyncModule: checkpoint por tienda (último BANDEJA_SYNC.ID procesado).
  checkpoint       SyncCheckpoint?
  hallazgosErp     ConciliacionHallazgo[]
  // F11 (ago 2026): ventanillas físicas del módulo de cajeros (1, 2, 3...).
  // Cada ventanilla puede estar asignada a un cajero a la vez.
  ventanillas      Ventanilla[]
  // F22 (oct 2026): mostradores físicos (1, 2, 3...) donde el operador llama al
  // cliente por la TV. Misma idea que las ventanillas del cajero.
  mostradores      Mostrador[]
  // F9 ago 2026: inbox de eventos Firebird→nube por tienda.
  syncEventInbox   SyncEventInbox[]
  // Oct 2026: cuenta bancaria propia de la tienda para transferencias (si no tiene, se usa la global).
  cuentasBancarias CuentaBancaria[]
  // Oct 2026 (impresión DTF): qué tecnologías imprime esta tienda y los trabajos que le tocan.
  tiendaDtf        TiendaDtf[]
  trabajosDtf      PedidoDtf[]

  @@map("tiendas")
}

model Usuario {
  id                Int        @id @default(autoincrement())
  email             String     @unique @db.VarChar(100)
  password          String     @db.VarChar(255)
  nombre            String     @db.VarChar(100)
  apellido          String?    @db.VarChar(100)
  telefono          String?    @db.VarChar(20)
  rol               RolUsuario @default(CLIENTE)
  activo            Boolean    @default(true)
  tiendaId          Int?       @map("tienda_id")
  emailVerified     Boolean    @default(false) @map("email_verified")
  lastLogin         DateTime?  @map("last_login")
  // F7 (jul 2026): ping cada 5min desde la tablet del bodeguero/cajero/mostrador.
  // El monitor lo usa junto con lastLogin para decidir si el operador está
  // "activo en su estación" (no sólo logueado alguna vez).
  ultimoHeartbeat   DateTime?  @map("ultimo_heartbeat")
  // F9 (ago 2026): código de lista de precios del cliente sincronizado
  // desde Firebird (CLIENTES.LISPRE '1'..'6'). El catálogo lo usa para
  // elegir qué columna de Precio.listaX mostrar al cliente logueado.
  listaPrecioCodigo String?    @map("lista_precio_codigo") @db.VarChar(2)
  // Soft delete: marca el usuario como eliminado sin borrar la fila, para
  // conservar pedidos/historial. `activo=false` = desactivado (reactivable);
  // `deletedAt != null` = eliminado (no aparece en listados). Los clientes
  // nunca se eliminan (solo se desactivan).
  deletedAt         DateTime?  @map("deleted_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  // Relaciones
  tienda                  Tienda?                   @relation(fields: [tiendaId], references: [id])
  tiendasCliente          UsuarioTienda[]
  pedidos                 Pedido[]                  @relation("PedidoCliente")
  pedidosAsignados        Pedido[]                  @relation("PedidoBodeguero")
  pedidosEnCaja           Pedido[]                  @relation("PedidoCajero")
  actividades             LogActividad[]
  propuestasCreadas       PedidoPropuesta[]         @relation("PropuestaCreador")
  propuestasForzadas      PedidoPropuesta[]         @relation("PropuestaForzador")
  // F13 (sep 2026): bodeguero que confirmó que la mercancía de un pedido
  // cancelado volvió al anaquel.
  reposicionesRepuestas   PedidoReposicion[]        @relation("ReposicionReponedor")
  mensajes                PedidoMensaje[]
  favoritos               Favorito[]
  kioskosActivados        Kiosko[]                  @relation("KioskoActivador")
  kioskosDesactivados     Kiosko[]                  @relation("KioskoDesactivador")
  kioskoPairingsAprobados KioskoPairing[]           @relation("KioskoPairingAprobador")
  // PR7 (sep 2026): operador que descartó avisos de llegada en mostrador.
  llegadasDescartadas     Pedido[]                  @relation("PedidoLlegadaDescartada")
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  // F11 (ago 2026): ventanilla física donde trabaja el cajero (1:1 nullable).
  // Se setea vía POST /cajero/ventanilla/elegir.
  ventanilla              Ventanilla?
  // F22 (oct 2026): mostrador físico donde trabaja el operador (1:1 nullable).
  // Se setea vía POST /pedidos/mostrador/puesto/elegir.
  mostrador               Mostrador?                @relation("MostradorOperador")
  // F22: pedidos que este operador mandó a llamar por la TV.
  pedidosLlamados         Pedido[]                  @relation("PedidoLlamadoPor")
  // Oct 2026 (pagos por transferencia): quién verificó / reembolsó, y comprobantes que subió o revisó.
  pagosVerificados        PedidoPagoTransferencia[] @relation("PagoVerificador")
  pagosReembolsados       PedidoPagoTransferencia[] @relation("PagoReembolsador")
  comprobantesSubidos     PagoComprobante[]         @relation("ComprobanteSubidoPor")
  comprobantesRevisados   PagoComprobante[]         @relation("ComprobanteRevisadoPor")
  // Oct 2026 (impresión DTF): trabajos propios, los que revisa/imprime y sus mensajes.
  trabajosDtf             PedidoDtf[]               @relation("DtfDueno")
  trabajosDtfAsignados    PedidoDtf[]               @relation("DtfAsignado")
  mensajesDtf             PedidoDtfMensaje[]

  @@map("usuarios")
}

model UsuarioTienda {
  id                Int      @id @default(autoincrement())
  usuarioId         Int      @map("usuario_id")
  tiendaId          Int      @map("tienda_id")
  localClienteId    Int?     @map("local_cliente_id")
  listaPrecioCodigo String?  @map("lista_precio_codigo") @db.VarChar(2)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  // F9: la migración 2212 pone DEFAULT CURRENT_TIMESTAMP. Mantenemos el default
  // para que coincida con BD. @updatedAt de Prisma lo sobreescribe en updates.
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tienda  Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tiendaId])
  @@index([tiendaId, localClienteId])
  @@map("usuarios_tiendas")
}

// F11 (ago 2026): ventanilla física de la tienda. La cantidad de
// ventanillas por tienda las define el admin. El cajero elige en cuál
// va a trabajar al iniciar sesión (1:1 con cajero vía cajeroId único).
model Ventanilla {
  id        Int      @id @default(autoincrement())
  tiendaId  Int      @map("tienda_id")
  numero    Int // 1, 2, 3... definido por el admin.
  // FK opcional a Usuario. Si está null, la ventanilla está libre.
  cajeroId  Int?     @unique @map("cajero_id")
  activa    Boolean  @default(true) @map("activa")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  tienda Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  cajero Usuario? @relation(fields: [cajeroId], references: [id], onDelete: SetNull)

  @@unique([tiendaId, numero])
  @@index([tiendaId])
  @@map("ventanillas")
}

// F22 (oct 2026): mostrador físico de la tienda — el equivalente de `Ventanilla`
// para el operador de mostrador. El admin define cuántos hay por tienda y el
// operador elige en cuál trabaja al entrar. Cuando llama a un cliente, la TV
// dice "Pasa al mostrador N".
//
// Es un modelo APARTE y no un `tipo` en `Ventanilla`: las queries del cajero
// listan TODAS las ventanillas de la tienda, y un campo discriminador habría
// colado los mostradores en su selector (o exigido tocar cada query).
model Mostrador {
  id         Int      @id @default(autoincrement())
  tiendaId   Int      @map("tienda_id")
  numero     Int // 1, 2, 3... definido por el admin.
  // FK opcional a Usuario. Si está null, el mostrador está libre.
  operadorId Int?     @unique @map("operador_id")
  activa     Boolean  @default(true) @map("activa")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tienda          Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  operador        Usuario? @relation("MostradorOperador", fields: [operadorId], references: [id], onDelete: SetNull)
  pedidosLlamados Pedido[] @relation("PedidoLlamadoMostrador")

  @@unique([tiendaId, numero])
  @@index([tiendaId])
  @@map("mostradores")
}

// Sesion eliminada en refactor B2B: auth stateless JWT.
// Reintroducir con migración si se reactiva revocación de refresh tokens.

// ==================== CATÁLOGO ====================

model Producto {
  id              Int      @id @default(autoincrement())
  codigo          String   @unique @db.VarChar(50)
  nombre          String   @db.VarChar(150)
  descripcion     String?  @db.Text
  imagenPrincipal String?  @map("imagen_principal") @db.VarChar(255)
  imagenes        String[]
  activo          Boolean  @default(true)
  categoria       String?  @db.VarChar(50)
  subcategoria    String?  @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relaciones
  productosTienda  ProductoTienda[]
  precios          Precio[]
  preciosCO        PrecioCO[]
  itemsPedido      ItemPedido[]
  favoritos        Favorito[]
  imagenesProducto ProductoImagen[]
  // Oct 2026 (impresión DTF): el producto-servicio "DTF por metro" del ERP, si ya está dado de alta.
  tiposDtf         DtfTipo[]

  @@map("productos")
}

// ==================== IMÁGENES DE PRODUCTO ====================
// Las imágenes se gestionan desde el panel ADMIN (S3). Los productos
// vienen de Firebird y NO se editan; aquí solo se asocian imágenes.
// Hasta 4 imágenes por (producto, color). colorId null = imagen general
// del producto (sin variante de color).
model ProductoImagen {
  id          Int      @id @default(autoincrement())
  productoId  Int      @map("producto_id")
  // Toda imagen pertenece a un color del producto. El bucket "general"
  // (colorId NULL) se eliminó: si no hay color, no hay imagen.
  colorId     Int      @map("color_id")
  url         String   @db.VarChar(500)
  orden       Int      @default(0)
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  color    Color    @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@index([productoId, colorId])
  @@index([productoId, esPrincipal])
  @@map("productos_imagenes")
}

model ProductoTienda {
  id         Int     @id @default(autoincrement())
  productoId Int     @map("producto_id")
  tiendaId   Int     @map("tienda_id")
  visible    Boolean @default(true)
  destacado  Boolean @default(false)
  orden      Int     @default(0)

  // Relaciones
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda   Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([productoId, tiendaId])
  @@map("productos_tienda")
}

// ==================== CORRIDAS Y TALLAS ====================

model Corrida {
  id          Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(50)
  descripcion String? @db.VarChar(100)
  activa      Boolean @default(true)

  // Relaciones
  tallas    Talla[]
  preciosCO PrecioCO[]

  @@map("corridas")
}

model Talla {
  id        Int    @id @default(autoincrement())
  corridaId Int    @map("corrida_id")
  nombre    String @db.VarChar(10)
  orden     Int    @default(0)

  // Relaciones
  corrida   Corrida    @relation(fields: [corridaId], references: [id], onDelete: Cascade)
  preciosCO PrecioCO[]

  @@unique([corridaId, nombre])
  @@map("tallas")
}

// ==================== COLORES ====================

model Color {
  id     Int     @id @default(autoincrement())
  codigo String  @unique @db.VarChar(10)
  // 40 = el ancho de `COLORES.DESCRIP` en Firebird (el sistema que manda). Con 30, 44 colores reales ("FS/ NEGRO FC/ GRIS…")
  // no se creaban y los pedidos con esos colores no podían guardar su línea.
  nombre String  @db.VarChar(40)
  hex    String? @db.VarChar(7)
  activo Boolean @default(true)

  // Relaciones
  preciosCO        PrecioCO[]
  imagenesProducto ProductoImagen[]

  @@map("colores")
}

// ==================== PRECIOS ====================

model Precio {
  id            Int       @id @default(autoincrement())
  productoId    Int       @map("producto_id")
  tiendaId      Int       @map("tienda_id")
  precioBase    Decimal   @map("precio_base") @db.Decimal(10, 2)
  precioOferta  Decimal?  @map("precio_oferta") @db.Decimal(10, 2)
  activo        Boolean   @default(true)
  vigenciaDesde DateTime? @map("vigencia_desde") @db.Date
  vigenciaHasta DateTime? @map("vigencia_hasta") @db.Date

  // F9 (ago 2026): 6 listas de precios sincronizadas desde Firebird
  // (PRECIOS.PRECIO1..6). precioBase sigue siendo sinónimo de lista1 para
  // compatibilidad con la API y frontend actuales.
  lista1 Decimal @default(0) @map("lista1") @db.Decimal(10, 2)
  lista2 Decimal @default(0) @map("lista2") @db.Decimal(10, 2)
  lista3 Decimal @default(0) @map("lista3") @db.Decimal(10, 2)
  lista4 Decimal @default(0) @map("lista4") @db.Decimal(10, 2)
  lista5 Decimal @default(0) @map("lista5") @db.Decimal(10, 2)
  lista6 Decimal @default(0) @map("lista6") @db.Decimal(10, 2)

  // Relaciones
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda   Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([productoId, tiendaId])
  @@map("precios")
}

// PRECIOSCO - Precios específicos por talla/color con stock
model PrecioCO {
  id         Int     @id @default(autoincrement())
  productoId Int     @map("producto_id")
  tiendaId   Int     @map("tienda_id")
  corridaId  Int     @map("corrida_id")
  tallaId    Int     @map("talla_id")
  colorId    Int     @map("color_id")
  precio     Decimal @db.Decimal(10, 2)
  // El SKU identifica la VARIANTE y el ERP lo repite en cada tienda (1 025 SKUs distintos en 7 733 filas de PRECIOSCO, cero
  // repetidos DENTRO de una tienda): es único por tienda, no global. Con `@unique` a secas solo la primera tienda en
  // sincronizar guardaba el precio de una variante y las demás fallaban (tiendas 4 a 8 casi sin precios).
  sku        String? @db.VarChar(50)

  // F9 (ago 2026): 6 listas de precios sincronizadas desde Firebird
  // (PRECIOSCO.PRECIO1..6). `precio` sigue siendo sinónimo de lista1.
  lista1 Decimal @default(0) @map("lista1") @db.Decimal(10, 2)
  lista2 Decimal @default(0) @map("lista2") @db.Decimal(10, 2)
  lista3 Decimal @default(0) @map("lista3") @db.Decimal(10, 2)
  lista4 Decimal @default(0) @map("lista4") @db.Decimal(10, 2)
  lista5 Decimal @default(0) @map("lista5") @db.Decimal(10, 2)
  lista6 Decimal @default(0) @map("lista6") @db.Decimal(10, 2)

  // Relaciones
  producto                Producto     @relation(fields: [productoId], references: [id], onDelete: Cascade)
  tienda                  Tienda       @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  corrida                 Corrida      @relation(fields: [corridaId], references: [id], onDelete: Cascade)
  talla                   Talla        @relation(fields: [tallaId], references: [id], onDelete: Cascade)
  color                   Color        @relation(fields: [colorId], references: [id], onDelete: Cascade)
  itemsPedido             ItemPedido[]
  sustitucionesPropuestas ItemPedido[] @relation("SustitucionPropuesta")

  @@unique([productoId, tiendaId, corridaId, tallaId, colorId])
  // Único por TIENDA (ver `sku`). Postgres deja pasar varios NULL: las variantes sin SKU no chocan.
  @@unique([tiendaId, sku])
  @@map("preciosco")
}

// Stock eliminado en refactor B2B: el modelo B2B no maneja inventario confiable.
// La columna Stock.cantidadReservada quedó sin uso. Reintroducir con migración si
// en el futuro se reactiva control de stock contra entrega.

// ==================== PEDIDOS B2B ====================

model Pedido {
  id           Int          @id @default(autoincrement())
  numeroPedido String       @unique @map("numero_pedido") @db.VarChar(20)
  // Oct 2026 (parte B): el FOLIO REAL del Sistema Comercial (10 dígitos, "0000152573"), tomado del consecutivo de
  // CONSECUTIVOS cuando bodega CIERRA EL SURTIDO (ver `PedidoFolioSolicitud`). Es el ID que ve el cliente, el que
  // va en el ticket y en el QR; `numeroPedido` (PD-…) queda como llave interna. NULL = aún no llega del ERP.
  // El prefijo que se muestra (HMO-, MXL-…) es `Tienda.serie` y es solo visual: aquí va el folio tal cual está en
  // Firebird. Único POR TIENDA (el consecutivo es por tienda: el mismo número existe en cada una).
  folioErp     String?      @map("folio_erp") @db.VarChar(10)
  usuarioId    Int          @map("usuario_id")
  tiendaId     Int          @map("tienda_id")
  estado       EstadoPedido @default(SOLICITADO)
  canalOrigen  CanalOrigen  @default(WEB) @map("canal_origen")
  // KIOSKO: si el pedido se originó en un kiosko físico, apunta al kiosko
  // que lo creó. NULL = pedido web. Permite trazabilidad: el cliente ve en su
  // historial "Pedido X hecho en kiosko Y, tienda Z".
  kioskoId     Int?         @map("kiosko_id")
  notas        String?      @db.Text

  // Información del cliente (snapshot, capturada al crear el pedido)
  clienteNombre   String  @map("cliente_nombre") @db.VarChar(100)
  clienteEmail    String  @map("cliente_email") @db.VarChar(100)
  clienteTelefono String? @map("cliente_telefono") @db.VarChar(20)

  // F8 (jul 2026): modo de entrega. Default DOMICILIO para no romper el flujo
  // legacy (frontend web siempre asume envío). El servicio lo recalcula en
  // crearPedido según los campos que llegan y el canalOrigen.
  modoEntrega ModoEntrega @default(DOMICILIO) @map("modo_entrega")

  // Envío
  shippingDireccion String? @map("shipping_direccion") @db.Text

  // Oct 2026 (16-oct): QUIÉN recogió el pedido cuando NO es el titular — el mandadero que mandó su
  // patrón, un familiar. Lo captura el operador de mostrador al confirmar la entrega. `null` = lo
  // recogió el titular (o el pedido es anterior a este campo): NO se guarda el nombre del titular,
  // que ya está en `clienteNombre`. Es constancia, no un permiso: sale en el historial, en el
  // detalle del pedido y en el correo de "entregado", donde el titular puede avisar si no reconoce a
  // quien lo recogió.
  recogioNombre              String?     @map("recogio_nombre") @db.VarChar(150)
  shippingReferencia         String?     @map("shipping_referencia") @db.VarChar(255)
  // F8 (jul 2026): dirección estructurada para envío a domicilio. Requeridos
  // por el service cuando modoEntrega=DOMICILIO.
  shippingColonia            String?     @map("shipping_colonia") @db.VarChar(120)
  shippingCodigoPostal       String?     @map("shipping_codigo_postal") @db.VarChar(10)
  // F8 (jul 2026): paquetería. El cliente o elige una, o marca
  // dejarAdminDecidePaqueteria=true y este campo queda NULL.
  shippingPaqueteria         Paqueteria? @map("shipping_paqueteria")
  dejarAdminDecidePaqueteria Boolean     @default(false) @map("dejar_admin_decide_paqueteria")

  // Totales
  subtotal  Decimal @db.Decimal(12, 2)
  descuento Decimal @default(0) @db.Decimal(12, 2)
  impuestos Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // Idempotencia para reintentos del cliente
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(64)

  // Asignación a bodeguero (para el monitor de bodega)
  // Se setea en /pedidos/bodega/:id/tomar. SetNull si el bodeguero se elimina.
  // Se limpia al confirmar surtido (el pedido pasa a PENDING_PAID y bodega ya no lo carga).
  asignadoAId Int?      @map("asignado_a_id")
  asignadoAt  DateTime? @map("asignado_at")

  // Asignación a cajero (monitor de ventanillas). Aplica a los pedidos en PENDIENTE_PAGO que se
  // cobran en ventanilla: kiosko y web, NO domicilio. Es el cajero logueado, que a su vez ocupa
  // una `Ventanilla` (1:1). Se toma con una guarda atómica: si dos cajeros lo toman a la vez,
  // uno gana y el otro recibe 409.
  cajeroAsignadoId Int?      @map("cajero_asignado_id")
  cajeroAsignadoAt DateTime? @map("cajero_asignado_at")

  // Oct 2026: EL LUGAR en la fila de caja. Es desde cuándo el cliente espera su turno de pago:
  // se escribe al entrar a PENDIENTE_PAGO (mostrador lo manda a pagar) y se limpia al salir.
  //
  // Antes la fila se ordenaba por `fechaPedido`, que es cuándo se HIZO el pedido, no cuándo
  // llegó a caja: un pedido web hecho a las 9:00 que mostrador mandó a pagar a las 11:10 pasaba
  // delante del cliente de kiosko que llegó a caja a las 11:05. Con esta columna:
  //   - "Devolver a la cola" (caja) conserva el lugar: no la toca.
  //   - "No se presentó" lo manda al FINAL: la reinicia a `now()`. Sin esto, el cliente que no
  //     acudió volvía a ser el primero y "Llamar siguiente" lo llamaba otra vez, y otra.
  colaCajaDesdeAt DateTime? @map("cola_caja_desde_at")

  // Oct 2026 (16-oct): "Regresar a la cola hasta que se valide". La cajera llamó a un cliente con
  // una transferencia SIN validar y decide no esperarlo en su ventanilla: lo suelta conservando su
  // lugar (`colaCajaDesdeAt` no se toca) y deja esta marca. Mientras la transferencia siga sin
  // verificar, "Llamar siguiente" lo salta; sin ella lo volvería a llamar de inmediato, y otra
  // vez (el mismo bucle que "No se presentó" ya resolvió). Cuando Tesorería verifica deja de
  // contar sola —el filtro exige ambas cosas—, así que no hace falta nadie que la limpie. Se
  // limpia igual al tomar el pedido una cajera y al salir de PENDIENTE_PAGO.
  esperaValidacionDesdeAt DateTime? @map("espera_validacion_desde_at")

  // F12 (sep 2026): reloj de atención del bodeguero. La urgencia de un pedido
  // mide cuánto tiempo lleva en MANOS del bodeguero, no el tiempo total desde
  // que se creó. El reloj se PAUSA mientras la pelota está del lado del cliente
  // (WAITING_CUSTOMER_APPROVAL) y se REANUDA cuando el cliente responde y vuelve
  // a ser tarea del bodeguero.
  //
  //   tiempoAtencionBodegaMs: tiempo acumulado en manos del bodeguero (ms).
  //   bodegaTurnoDesdeAt:     cuándo empezó el turno actual del bodeguero.
  //                           NULL = el reloj está pausado (esperando al cliente).
  //
  // El tiempo "en manos del bodeguero" en un instante T es:
  //   tiempoAtencionBodegaMs + (bodegaTurnoDesdeAt ? T - bodegaTurnoDesdeAt : 0)
  tiempoAtencionBodegaMs Int       @default(0) @map("tiempo_atencion_bodega_ms")
  bodegaTurnoDesdeAt     DateTime? @map("bodega_turno_desde_at")

  // F13 (sep 2026): cuándo el cliente pidió un asesor de ventas desde una
  // propuesta de bodega. NULL = nunca lo pidió. El pedido pasa a EN_ASESORIA
  // y entra a la cola de VENTAS de su tienda (que es 1 por tienda, sin
  // asignación 1:1 — no hay vendedorAsignadoId).
  asesorSolicitadoAt DateTime? @map("asesor_solicitado_at")
  // Oct 2026: aquí vivía `asesorSolicitudNota` (F13), la nota libre que el
  // cliente escribía al pedir un asesor. Se ELIMINÓ: ese texto ahora ES el
  // primer mensaje del chat con el asesor (`PedidoMensaje`), así que la
  // columna era una segunda copia del mismo dato — justo la que el asesor leía
  // en su cola, mientras el cliente seguía escribiendo en el chat.

  // PR7 (sep 2026): aviso de "el cliente ya está en tienda" para pedidos
  // web que se recogerán en mostrador. Es una señal de cola, NO un
  // estado del pedido (puede ocurrir en REVIEWING, PENDING_PAID, PAID,
  // SHIPPED, etc.). Decisión: columnas y no estado, porque es ortogonal
  // al ciclo de vida. Ver kiosko-llegada.service.ts para el flujo.
  //
  // - llegadaAnunciadaAt: PRIMER aviso (mide espera real del cliente).
  // - llegadaUltimoAvisoAt: ÚLTIMO aviso (frescura del badge en mostrador).
  // - llegadaAnunciadaCount: cuántos avisos lleva (anti-spam).
  // - llegadaAnunciadaCanal: QR | FOLIO | WEB | MOSTRADOR.
  // - llegadaAnunciadaKioskoId: si vino del kiosko, qué kiosko.
  // - llegadaAnunciadaPor: snapshot del nombre del kiosko u operador
  //   (NO FK: si el kiosko se borra, el texto sigue legible para
  //   auditoría).
  // - llegadaDescartadaAt + PorId: cuando el mostrador descarta un
  //   aviso falso (cliente se fue sin recoger, etc.).
  llegadaAnunciadaAt       DateTime?     @map("llegada_anunciada_at")
  llegadaUltimoAvisoAt     DateTime?     @map("llegada_ultimo_aviso_at")
  llegadaAnunciadaCount    Int           @default(0) @map("llegada_anunciada_count")
  // F16 (sep 2026): cuándo se EMITIÓ el último aviso al mostrador (no cuándo
  // llegó el último request). Es el ancla del límite de tasa: sin una columna
  // propia, la ventana se medía desde `llegadaUltimoAvisoAt`, que se reescribe
  // en CADA aviso, así que un cliente que insistía más seguido que la ventana
  // nunca la cumplía y su pedido quedaba sin alerta en la TV indefinidamente.
  llegadaUltimaEmisionAt   DateTime?     @map("llegada_ultima_emision_at")
  llegadaAnunciadaCanal    CanalLlegada? @map("llegada_anunciada_canal")
  llegadaAnunciadaKioskoId Int?          @map("llegada_anunciada_kiosko_id")
  llegadaAnunciadaPor      String?       @map("llegada_anunciada_por") @db.VarChar(60)
  llegadaDescartadaAt      DateTime?     @map("llegada_descartada_at")
  llegadaDescartadaPorId   Int?          @map("llegada_descartada_por_id")

  // F22 (oct 2026): la cola del mostrador es "primero llegado, primero atendido".
  //
  // `presenteDesdeAt` es DESDE CUÁNDO está el cliente físicamente esperando:
  //   - KIOSKO: la hora del pedido (el cliente estaba ahí al hacerlo).
  //   - WEB:    la hora del aviso de llegada.
  // Es la ÚNICA llave de orden de la cola, la consola y la TV. Antes se ordenaba
  // por `llegadaAnunciadaAt nulls last`, y como un pedido de kiosko no tiene
  // aviso, TODO web con aviso pasaba delante de cualquier kiosko aunque el
  // kiosko llevara media hora esperando.
  //
  // Se conserva al "Devolver a la cola" (es el que no pierde su lugar) y se
  // reinicia al "No se presentó" (pasa al final) y cuando el cliente vuelve a
  // avisar tras un descarte (llegó de verdad ahora, no hace dos horas).
  presenteDesdeAt  DateTime? @map("presente_desde_at")
  // Cuántas veces el mostrador descartó el aviso de ESTE pedido. A la segunda el
  // botón web se bloquea: solo el kiosko o el operador pueden volver a marcar la
  // llegada (un cliente que avisa en falso dos veces ya no se cree por web).
  llegadaDescartes Int       @default(0) @map("llegada_descartes")

  // F16 (sep 2026): "Atendiendo" del monitor de mostrador.
  //
  // Cuando el operador manda a llamar a un cliente, el pedido deja la cola de
  // espera y pasa al panel "Atendiendo" de la TV. Modelo "TV bancaria": el
  // folio llamado se QUEDA visible hasta que el pedido pasa al siguiente paso,
  // en vez de desvanecerse a los 6s como la alerta.
  //
  // Es una señal de cola, NO un estado — el pedido sigue en EN_MOSTRADOR.
  // `PedidoStateService.cambiarEstado` la limpia sola en cuanto el pedido sale
  // de EN_MOSTRADOR, así que no puede quedar un pedido "atendido" en otro
  // estado (ver el comentario en ese archivo).
  llamadoAt          DateTime? @map("llamado_at")
  // F22 (oct 2026): QUIÉN llamó y A QUÉ MOSTRADOR. La TV dice "Pasa al mostrador
  // 2" y la consola de los demás operadores dice "Lo atiende Ana". Se escriben
  // dentro de la misma transacción que la transición a EN_ATENCION y se limpian
  // al salir de ella (junto con `llamadoAt`).
  llamadoPorId       Int?      @map("llamado_por_id")
  llamadoMostradorId Int?      @map("llamado_mostrador_id")
  // Cuántas veces se llamó a este pedido y el cliente no se presentó. A la
  // segunda se descarta su aviso de llegada.
  llamadasFallidas   Int       @default(0) @map("llamadas_fallidas")

  // F22 (oct 2026): la bolsa está en el área de entrega esperando al cliente.
  //
  // Es desde cuándo el pedido está en REVISADO / ESPERANDO_APROBACION. De aquí
  // sale (a) el recordatorio "¿aún lo quieres?" y (b) la lista de pedidos sin
  // recoger que el operador puede cancelar. NO se reinicia al devolver a la cola
  // ni al llamar: es la antigüedad de la ESPERA, no de la última acción.
  esperaClienteDesdeAt   DateTime? @map("espera_cliente_desde_at")
  // Cuándo se mandó el correo "¿aún quieres tu pedido?". Una sola vez por ciclo
  // de espera; se limpia si el cliente confirma que sigue interesado.
  recordatorioRecogerAt  DateTime? @map("recordatorio_recoger_at")
  // Cuántas veces el cliente contestó "sí, lo quiero". Tope de 2: un cliente
  // que posterga para siempre una bolsa apartada no puede hacerlo sin que el
  // mostrador lo decida.
  interesConfirmadoCount Int       @default(0) @map("interes_confirmado_count")

  // F15 (sep 2026): marcas de agua de lectura del chat (modelo WhatsApp/Telegram).
  //   * Por LADO, no por usuario (hay UN asesor por tienda, así que "tienda leyó" es la
  //     unidad correcta; si algún día hay varios asesores por tienda, migrar a una tabla
  //     PedidoChatLectura con (userId, pedidoId, ultimoMensajeLeidoId)).
  //   * Por ID de mensaje, no por timestamp: id es autoincrement monótono y clock-free;
  //     timestamp(3) tiene colisiones de ms y deriva entre instancias. Comparar
  //     `m.id <= watermark` es O(1) y estable sin importar el reloj.
  //
  // cliente_ultimo_mensaje_entregado_id: el cliente recibió el último eco del socket.
  //   No se persiste via REST; el cliente lo bumpea al recibir el eco, idempotente.
  // cliente_ultimo_mensaje_leido_id: el cliente abrió el detalle con foco, persistido via REST.
  // tienda_ultimo_mensaje_leido_id: alguien del lado tienda abrió el detalle con foco.
  clienteUltimoMensajeEntregadoId Int? @map("cliente_ultimo_mensaje_entregado_id")
  clienteUltimoMensajeLeidoId     Int? @map("cliente_ultimo_mensaje_leido_id")
  tiendaUltimoMensajeLeidoId      Int? @map("tienda_ultimo_mensaje_leido_id")

  // Oct 2026 (pagos por transferencia): lo que el cliente ELIGIÓ al hacer el pedido. No vincula
  // nada: el compromiso real es que exista un `PedidoPagoTransferencia` activo. Sirve para
  // preseleccionar la opción cuando el pedido llega a PENDIENTE_PAGO y para que caja y mostrador
  // sepan qué esperar. Siempre null en pedidos a domicilio (la transferencia no aplica ahí todavía).
  metodoPagoPreferido MetodoPago? @map("metodo_pago_preferido")

  // Timestamps
  fechaPedido DateTime  @default(now()) @map("fecha_pedido")
  // Lo rellena el webhook del sistema externo (Firebird) al confirmar el cobro,
  // o el admin manualmente como herramienta de soporte.
  fechaPago   DateTime? @map("fecha_pago")

  // Relaciones
  usuario              Usuario                   @relation("PedidoCliente", fields: [usuarioId], references: [id])
  tienda               Tienda                    @relation(fields: [tiendaId], references: [id])
  kiosko               Kiosko?                   @relation("PedidoKioskoOrigen", fields: [kioskoId], references: [id], onDelete: SetNull)
  // PR7 (sep 2026): kiosko que AVISÓ la llegada (no necesariamente el
  // kiosko que creó el pedido). Cuando llega vía el kiosko del cliente,
  // esta FK se popula; cuando llega por web/app, queda null.
  kioskoLlegada        Kiosko?                   @relation("PedidoKioskoLlegada", fields: [llegadaAnunciadaKioskoId], references: [id], onDelete: SetNull)
  asignadoA            Usuario?                  @relation("PedidoBodeguero", fields: [asignadoAId], references: [id], onDelete: SetNull)
  cajeroAsignado       Usuario?                  @relation("PedidoCajero", fields: [cajeroAsignadoId], references: [id], onDelete: SetNull)
  llegadaDescartadaPor Usuario?                  @relation("PedidoLlegadaDescartada", fields: [llegadaDescartadaPorId], references: [id], onDelete: SetNull)
  llamadoPor           Usuario?                  @relation("PedidoLlamadoPor", fields: [llamadoPorId], references: [id], onDelete: SetNull)
  llamadoMostrador     Mostrador?                @relation("PedidoLlamadoMostrador", fields: [llamadoMostradorId], references: [id], onDelete: SetNull)
  items                ItemPedido[]
  historial            HistorialPedido[]
  actividades          LogActividad[]
  propuestas           PedidoPropuesta[]
  mensajes             PedidoMensaje[]
  notificaciones       Notificacion[]
  mensajeEnviado       MensajeBodegueroEnviado?
  // F9 (ago 2026): cola de envío hacia Firebird. 1:1 con Pedido.
  pendienteEnvio       PedidoPendienteEnvio?
  // Oct 2026 (parte B): la solicitud del folio al agente (la nube pide, el agente sondea y reserva).
  folioSolicitud       PedidoFolioSolicitud?
  // F13 (sep 2026): lista de reposición. 1:1 con Pedido, sólo existe si el
  // pedido se canceló por rechazo del cliente (los productos vuelven al anaquel).
  reposicion           PedidoReposicion?
  // Oct 2026: pagos por transferencia de este pedido (a lo más UNO activo; el resto es historial).
  pagosTransferencia   PedidoPagoTransferencia[]
  intervenciones       PedidoIntervencion[]
  // Oct 2026: por qué canceló el CLIENTE (opcional). Solo existe si dio un motivo. NO es columna de `Pedido` a propósito:
  // muchas respuestas devuelven la fila completa y el motivo es para el negocio, no para el cliente ni las TV.
  cancelacionCliente   PedidoCancelacionCliente?
  tareasErp            TareaSistemaComercial[]
  hallazgosErp         ConciliacionHallazgo[]
  // Oct 2026 (impresión DTF): los trabajos de impresión del pedido (PLAN-DTF.md D1: carril propio).
  trabajosDtf          PedidoDtf[]

  // Oct 2026 (parte B): el folio es único dentro de la tienda (Postgres deja pasar los NULL: los pedidos sin folio
  // no chocan). Atrapa una doble asignación y es el índice de la búsqueda por folio.
  @@unique([tiendaId, folioErp], map: "pedidos_tienda_folio_erp_key")
  @@index([tiendaId, estado])
  @@index([usuarioId])
  @@index([cajeroAsignadoId])
  @@index([estado, canalOrigen])
  @@index([asignadoAId])
  @@index([kioskoId])
  // PR7 (sep 2026): mostrar pedidos con aviso de llegada primero,
  // FIFO entre los que llevan más tiempo esperando. El WHERE se
  // implementa como índice parcial en la migración SQL porque
  // Prisma no soporta @@index.where.
  @@index([tiendaId, llegadaAnunciadaAt])
  // F16: el panel "Atendiendo" de la TV. El WHERE se implementa como índice
  // parcial en la migración SQL (Prisma no soporta @@index.where).
  @@index([tiendaId, llamadoAt])
  // F22: la llave de orden de la cola de mostrador.
  @@index([tiendaId, estado, presenteDesdeAt])
  // F22: el barrido de pedidos que esperan al cliente (recordatorio y vencidos).
  @@index([estado, esperaClienteDesdeAt])
  @@map("pedidos")
}

model ItemPedido {
  id             Int     @id @default(autoincrement())
  pedidoId       Int     @map("pedido_id")
  productoId     Int     @map("producto_id")
  precioCOId     Int?    @map("precioco_id") // Opcional: SetNull si PrecioCO se borra (snapshot guarda todo)
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  // Promo de volumen (sep 2026): 12+ piezas → precio de lista 2.
  //
  // Se congelan los DOS precios candidatos al crear el pedido, y
  // `precioUnitario` es el efectivo (lo que leen el ERP, los totales y la UI).
  // Guardar el par hace que el precio efectivo sea una función exacta de dos
  // números congelados: la promo se puede re-evaluar cuando el pedido cambia
  // de tamaño (bodega surte de menos, mostrador agrega productos) sin releer
  // `PrecioCO` — que pudo cambiar en Firebird mientras el pedido estaba en
  // bodega, y que puede haberse borrado (`precioCOId` es nullable).
  //
  // NULL = pedido anterior a la promo: nunca entra a la regla.
  precioUnitarioBase    Decimal? @map("precio_unitario_base") @db.Decimal(10, 2)
  precioUnitarioMayoreo Decimal? @map("precio_unitario_mayoreo") @db.Decimal(10, 2)

  // F19 (oct 2026): LA CANTIDAD QUE EL CLIENTE PIDIÓ, inmutable.
  //
  // Es la única columna que conserva "lo que se pidió" después de que bodega
  // cierra el surtido. `cantidad` NO sirve para eso: `aplicarCambiosFisicos` la
  // SOBRESCRIBE con lo surtido (10 de 20 → `cantidad: 10`), que es lo correcto
  // para el dinero (es lo que se cobra) pero destruye la referencia.
  //
  // Sin esta columna, cada pantalla que quiere mostrar "Solicitados 20 ·
  // Disponibles 10" tiene que RECONSTRUIR el 20 desde el snapshot de una
  // propuesta viva, y en cuanto la propuesta se resuelve el snapshot se apaga y
  // la pantalla miente ("Sin cambios", 10 piezas). Por eso el detalle de ventas,
  // el editor del asesor y el resumen de bodega mostraban un pedido incompleto
  // como si estuviera completo.
  //
  // Se escribe UNA sola vez, en `construirItemPedido`, y ningún camino la muta.
  // El nombre anterior (`cantidad_original`) describía un consumidor que ya no
  // existe: el handler de MOVPED que la comparaba contra lo reportado por
  // Firebird se eliminó (ver `pedido-pago.handler.ts`), así que su comentario
  // hablaba de un lector muerto.
  cantidadPedida Int @default(0) @map("cantidad_pedida")

  // Snapshot de los datos (no cambia aunque el producto/variante cambien)
  productoNombre String @map("producto_nombre") @db.VarChar(150)
  productoCodigo String @map("producto_codigo") @db.VarChar(50)
  corridaNombre  String @map("corrida_nombre") @db.VarChar(50)
  tallaNombre    String @map("talla_nombre") @db.VarChar(10)
  colorNombre    String @map("color_nombre") @db.VarChar(40)

  // B2B: flags para auditoría de revisión
  original  Boolean @default(true) // false = agregado por revisión aceptada
  cancelada Boolean @default(false) // true = rechazado en revisión o cancelado por bodega

  // Surtido en bodega: track de qué encontró el bodeguero vs qué pidió el cliente
  cantidadSurtida Int           @default(0) @map("cantidad_surtida")
  estadoSurtido   EstadoSurtido @default(PENDIENTE) @map("estado_surtido")
  surtidoAt       DateTime?     @map("surtido_at")

  // F21 (oct 2026): cuántas piezas de esta línea YA se sacaron de la bolsa del
  // área de entrega.
  //
  // El predicado `piezasFueraDeLaBolsa` es POSICIONAL: mira `cantidadSurtida`
  // contra `cantidad`. Una vez que el bodeguero saca las prendas, NADA en la BD
  // cambia — el checklist del sheet vive en estado local y se pierde al cerrar.
  // Si el pedido vuelve a bodega por un segundo ajuste, el predicado reporta otra
  // vez las mismas prendas y el bodeguero va a buscar mercancía que ya sacó.
  //
  // Esta columna registra el hecho. `piezasPendientesDeRetiro` resta lo hecho de
  // lo que hay que hacer, y es la que gobierna la tarjeta y el checklist.
  //
  // Es un CONTEO y no un flag booleano a propósito: si el ajuste 1 quita 2 y el
  // ajuste 2 quita 1 más, el total fuera de la bolsa es 3 — un `retiradoAt` ya
  // puesto reportaría 0 y la tercera prenda nunca saldría de la bolsa.
  //
  // OJO con el nombre: `piezasRetiradas` también nombra una variable local (un
  // `Map<itemId, piezas>`) en `aplicar-propuesta-ventas.util.ts` y en
  // `retiro-reposicion.spec.ts`. Es otra cosa — ese mapa es el transporte hacia
  // `crearDesdeAjuste`. No confundir los dos.
  piezasRetiradas Int @default(0) @map("piezas_retiradas")

  // Oct 2026 (propuestas, decisión 2 del dueño): cuántas piezas de esta línea YA
  // estaban en la bolsa cuando se subió la cantidad, y que bodega NO tiene que
  // volver a verificar.
  //
  // Al subir de 3 a 5 con 3 en la bolsa, bodega verifica SOLO las 2 extra. Antes la
  // línea se reiniciaba entera (`cantidadSurtida: 0`, PENDIENTE) y bodega
  // re-verificaba las 5 — cuando 3 ya estaban físicamente en la bolsa del área de
  // entrega. Ahora la línea se "rebasa": `cantidadSurtida` = lo que hay en la bolsa
  // (3), `piezasRetiradas` = 0 y `piezasBase` = 3. Lo que bodega marque es el total
  // (3 + lo que encuentre), nunca menos que `piezasBase`.
  //
  // Es un PISO durable y no se puede derivar de otras columnas: en cuanto bodega
  // marca la línea, `cantidadSurtida` pasa a ser el total y se pierde cuántas ya
  // estaban. Sin el piso, un "No hay" por costumbre —o corregir hacia abajo tras
  // recargar— cancelaría una línea que tiene piezas dentro de la bolsa: ni el
  // checklist de retiro ni la reposición sabrían de ellas.
  //
  // Vive solo durante UNA ronda de surtido: `confirmarSurtido` la limpia a 0 en
  // todas las líneas, y una baja de cantidad también (la línea ya no espera nada).
  piezasBase Int @default(0) @map("piezas_base")

  // B2B surtido B2.6: motivo textual del bodeguero al marcar el item
  // (ej. "No hay talla M", "Sólo hay 2 piezas"). Se propaga al PedidoRevisionItem.motivo
  // al confirmarSurtido si hay faltante. Nullable: items sin tocar no tienen motivo.
  motivoSurtido String? @map("motivo_surtido") @db.Text

  // B2B surtido B2.6: si el bodeguero eligió una variante sustituta (otra talla/color u
  // otro producto) desde la quick option, se guarda aquí el PrecioCO propuesto. Al
  // confirmarSurtido genera una PedidoRevisionItem con nuevoPrecioCOId para que el
  // cliente apruebe. SetNull si el PrecioCO se elimina (snapshot guarda todos los demás
  // datos en productoNombre/codigo/talla/color).
  sustitucionPropuestaPrecioCOId Int?      @map("sustitucion_propuesta_precioco_id")
  sustitucionPropuesta           PrecioCO? @relation("SustitucionPropuesta", fields: [sustitucionPropuestaPrecioCOId], references: [id], onDelete: SetNull)

  // Relaciones
  pedido   Pedido          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto        @relation(fields: [productoId], references: [id])
  precioCO PrecioCO?       @relation(fields: [precioCOId], references: [id], onDelete: SetNull)
  mensajes PedidoMensaje[]

  @@index([pedidoId, cancelada])
  @@map("items_pedido")
}

// F12 (sep 2026): propuesta de ajuste que bodega envía al cliente cuando
// faltan productos. Reemplaza el flujo formal de revisión (PedidoRevision)
// por una negociación vía chat con un modelo verificable server-side.
//
// La propuesta se ATA AL PEDIDO, no al bodeguero: si el bodeguero la libera
// a la cola, la propuesta persiste y la respuesta del cliente se aplica al
// pedido sin importar quién esté asignado.
//
// `items` es un JSON con la propuesta completa (mismo shape que el frontend
// `lib/propuesta.ts`): array de { itemId, tipo, producto, variante, cantidad,
// precioUnitario, subtotal, ... }. Se guarda como snapshot para que la
// propuesta no cambie aunque el pedido/items cambien después.
//
// F13 (sep 2026): la propuesta puede venir de BODEGA (solo hay todo/menos/no
// hay) o de VENTAS (puede cambiar productos, cantidades y variantes). Las
// decisiones legales del cliente dependen del origen — ver
// `creadaPorRol` y `PropuestaService`.
model PedidoPropuesta {
  id           Int             @id @default(autoincrement())
  pedidoId     Int             @map("pedido_id")
  estado       EstadoPropuesta @default(PENDIENTE)
  items        Json            @db.Json
  total        Decimal         @db.Decimal(12, 2)
  // Nota libre del bodeguero que acompaña la propuesta (ej. "Sólo hay 2 piezas").
  nota         String?         @db.Text
  creadaPorId  Int             @map("creada_por_id")
  // F13: snapshot del rol del autor (mismo patrón que PedidoMensaje.autorRol).
  // Determina qué decisiones puede tomar el cliente: una propuesta de BODEGA
  // admite CONTACTAR_ASESOR; una de VENTAS admite CANCELAR_PEDIDO.
  creadaPorRol RolUsuario      @default(BODEGA) @map("creada_por_rol")
  enviadaAt    DateTime        @default(now()) @map("enviada_at")
  // Cuándo el cliente respondió (aceptó o rechazó). NULL = aún pendiente.
  respondidaAt DateTime?       @map("respondida_at")
  // Oct 2026 (propuestas, 3c): cuándo el CLIENTE abrió la propuesta por primera vez.
  // NULL = nunca la ha visto. Sin esto mostrador solo podía decir "sin respuesta", y
  // "no contestó" y "ni siquiera la abrió" piden acciones distintas: el segundo es el
  // cliente que no se enteró y está parado en el mostrador. Solo cuenta el cliente
  // dueño del pedido (no el personal que la lee) y solo mientras está PENDIENTE.
  vistaAt      DateTime?       @map("vista_at")
  // F13 (sep 2026): cuándo bodega CONSUMIÓ esta propuesta aceptada al cerrar
  // el surtido. Sin esto, una propuesta ACEPTADA en la ronda 1 autorizaría
  // faltantes de la ronda 2 sin que el cliente los haya aprobado (el bug de
  // loop: `confirmarSurtido` busca la última ACEPTADA sin importar si ya se
  // aplicó). `confirmarSurtido` exige `consumidaAt IS NULL`.
  consumidaAt  DateTime?       @map("consumida_at")
  // F12: nota del cliente al responder (ej. motivo del rechazo). Se guarda
  // aquí para que el bodeguero la vea en el historial de propuestas.
  notaCliente  String?         @map("nota_cliente") @db.Text
  // Si el admin forzó la aprobación sin respuesta del cliente, se registra aquí.
  forzadaPorId Int?            @map("forzada_por_id")
  forzadaAt    DateTime?       @map("forzada_at")

  // Relaciones
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  creadaPor  Usuario  @relation("PropuestaCreador", fields: [creadaPorId], references: [id])
  forzadaPor Usuario? @relation("PropuestaForzador", fields: [forzadaPorId], references: [id])

  // F13: índice único PARCIAL sobre (pedidoId) WHERE estado = 'PENDIENTE'.
  // No se puede declarar en Prisma (no soporta índices parciales) — vive en
  // la migración SQL. Cierra la carrera del "no apilar PENDIENTES": ahora que
  // BODEGA y VENTAS pueden proponer sobre el mismo pedido, dos envíos
  // concurrentes crearían dos PENDIENTES y la segunda quedaría zombi.
  @@index([pedidoId, estado])
  @@map("pedidos_propuestas")
}

model PedidoMensaje {
  id                 Int        @id @default(autoincrement())
  pedidoId           Int        @map("pedido_id")
  itemId             Int?       @map("item_id")
  autorId            Int        @map("autor_id")
  autorRol           RolUsuario @map("autor_rol")
  contenido          String     @db.Text
  visibleParaCliente Boolean    @default(true) @map("visible_para_cliente")
  createdAt          DateTime   @default(now()) @map("created_at")
  // F13 (sep 2026): adjuntos del mensaje. Modelo discriminado por `tipo`:
  // - { tipo: 'propuesta', propuestaId: number } para mensajes que viajan
  //   junto a una propuesta (estilo WhatsApp/Airbnb).
  // La columna es JSONB sin CHECK para no romper migraciones futuras; la
  // validación del discriminador vive en el DTO del backend.
  // Sin @db.Json a propósito: el default de Prisma en PostgreSQL es jsonb,
  // que es lo que la columna realmente es (y lo deseable: indexable).
  adjunto            Json?      @map("adjunto")

  // Relaciones
  pedido         Pedido                    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  item           ItemPedido?               @relation(fields: [itemId], references: [id], onDelete: SetNull)
  autor          Usuario                   @relation(fields: [autorId], references: [id])
  mensajeEnviado MensajeBodegueroEnviado[]

  @@index([pedidoId, createdAt])
  @@index([itemId])
  @@map("pedidos_mensajes")
}

// F8 (jul 2026): marca que ya se envió el email de "primera respuesta del
// bodeguero" para este pedido. Garantiza que sólo se manda UNA vez por
// pedido aunque el bodeguero intercambie varios mensajes en el chat.
// pedidoId es PK (un pedido -> máximo un email de este tipo).
model MensajeBodegueroEnviado {
  pedidoId  Int      @id @map("pedido_id")
  mensajeId Int      @map("mensaje_id")
  enviadoAt DateTime @default(now()) @map("enviado_at")

  pedido  Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  mensaje PedidoMensaje @relation(fields: [mensajeId], references: [id], onDelete: Cascade)

  @@map("mensaje_bodeguero_enviado")
}

// ComprobantePago eliminado en refactor de pagos fuera del sistema (jun 2026).
// El cobro se realiza en un sistema externo (Visual FoxPro + Firebird) que
// notifica al backend vía webhook (`POST /pedidos/admin/:id/marcar-pagado`,
// autenticado por X-Agent-Key). No reintroducir este modelo sin antes evaluar
// si el sistema externo va a generar sus propios recibos.

// ==================== PAGOS POR TRANSFERENCIA (oct 2026) ====================
//
// Ver PLAN-PAGOS-TRANSFERENCIA.md. Principio rector: `PAGADO` sigue naciendo SOLO de VFP.
// Tesorería verifica que el dinero llegó; la tienda registra el cobro en VFP; el agente lo sube.
// Estos modelos son un subsistema paralelo al pedido: no tocan `EstadoPedido` ni la cola hacia
// Firebird.
//
// Los índices PARCIALES (que Prisma no sabe declarar) viven en la migración SQL
// `20261018120000_pagos_transferencia`:
//   - un solo pago ACTIVO por pedido,
//   - una misma clave de rastreo no puede pagar dos pedidos,
//   - una sola cuenta bancaria activa por ámbito (global o por tienda).

// Cuenta a la que el cliente transfiere. La administra ADMIN. `tiendaId` null = cuenta global.
// Cada pago guarda un SNAPSHOT de la cuenta con la que se le dieron las instrucciones, así que
// editar la cuenta no reescribe lo que ya se le dijo a clientes con pagos abiertos.
model CuentaBancaria {
  id            Int      @id @default(autoincrement())
  tiendaId      Int?     @map("tienda_id")
  banco         String   @db.VarChar(60)
  titular       String   @db.VarChar(120)
  // 18 dígitos, validada con su dígito verificador al guardar.
  clabe         String   @db.VarChar(18)
  cuenta        String?  @db.VarChar(20)
  // Texto extra que el negocio quiera agregar a las instrucciones.
  instrucciones String?  @db.Text
  activa        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tienda Tienda? @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, activa])
  @@map("cuentas_bancarias")
}

model PedidoPagoTransferencia {
  id       Int                     @id @default(autoincrement())
  pedidoId Int                     @map("pedido_id")
  estado   EstadoPagoTransferencia @default(PENDIENTE)

  // Snapshot al emitir las instrucciones: lo que se le dijo al cliente no cambia aunque cambien
  // la cuenta o (por error) el total del pedido.
  montoEsperado    Decimal @map("monto_esperado") @db.Decimal(12, 2)
  cuentaSnapshot   Json    @map("cuenta_snapshot")
  // "Referencia" del SPEI: 7 dígitos (el límite del campo), aleatoria y única. No es el id del pedido.
  referencia       String  @db.VarChar(7)
  // "Concepto de pago": alfanumérico sin guiones (varios bancos los rechazan).
  concepto         String  @db.VarChar(30)
  // Cuántos comprobantes se han rechazado en este pago.
  intentos         Int     @default(0)
  // Si no es null, hay algo que aclarar antes de aprobar (el total cambió en VFP, el pedido se
  // canceló o se cobró en tienda teniendo un comprobante en revisión...). Texto para Tesorería.
  requiereRevision String? @map("requiere_revision") @db.Text

  // Resultado de la verificación (Tesorería).
  montoVerificado  Decimal?  @map("monto_verificado") @db.Decimal(12, 2)
  abonoFecha       DateTime? @map("abono_fecha")
  claveRastreo     String?   @map("clave_rastreo") @db.VarChar(40)
  verificadoPorId  Int?      @map("verificado_por_id")
  verificadoAt     DateTime? @map("verificado_at")
  notaVerificacion String?   @map("nota_verificacion") @db.Text

  // VFP registró el cobro.
  aplicadoAt DateTime? @map("aplicado_at")

  // Reembolso.
  reembolsoMonto   Decimal?  @map("reembolso_monto") @db.Decimal(12, 2)
  reembolsoMotivo  String?   @map("reembolso_motivo") @db.Text
  reembolsoRef     String?   @map("reembolso_ref") @db.VarChar(60)
  reembolsadoPorId Int?      @map("reembolsado_por_id")
  reembolsadoAt    DateTime? @map("reembolsado_at")

  // Quién emitió las instrucciones (el cliente, o un empleado a su nombre).
  creadoPorId  Int?        @map("creado_por_id")
  creadoPorRol RolUsuario? @map("creado_por_rol")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Restrict a propósito: los pagos y su bitácora no se van en cascada con el pedido.
  pedido         Pedido                    @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  verificadoPor  Usuario?                  @relation("PagoVerificador", fields: [verificadoPorId], references: [id], onDelete: SetNull)
  reembolsadoPor Usuario?                  @relation("PagoReembolsador", fields: [reembolsadoPorId], references: [id], onDelete: SetNull)
  comprobantes   PagoComprobante[]
  eventos        PagoTransferenciaEvento[]

  @@unique([referencia])
  @@index([pedidoId])
  @@index([estado, createdAt])
  @@map("pedidos_pagos_transferencia")
}

model PagoComprobante {
  id          Int               @id @default(autoincrement())
  pagoId      Int               @map("pago_id")
  subidoPorId Int               @map("subido_por_id")
  // Key de almacenamiento PRIVADO (nunca una URL). Se sirve solo por un endpoint autorizado.
  archivoKey  String            @map("archivo_key") @db.VarChar(255)
  // Detectado por la firma binaria del archivo, no el que declara el cliente.
  mime        String            @db.VarChar(40)
  bytes       Int
  sha256      String            @db.VarChar(64)
  estado      EstadoComprobante @default(PENDIENTE)

  // Lo que declara el cliente. Es ayuda para buscar en el banco; nunca se confía en ello.
  montoDeclarado        Decimal?  @map("monto_declarado") @db.Decimal(12, 2)
  fechaDeclarada        DateTime? @map("fecha_declarada")
  bancoEmisor           String?   @map("banco_emisor") @db.VarChar(60)
  claveRastreoDeclarada String?   @map("clave_rastreo_declarada") @db.VarChar(40)

  motivoRechazo String?   @map("motivo_rechazo") @db.VarChar(30)
  notaRechazo   String?   @map("nota_rechazo") @db.Text
  revisadoPorId Int?      @map("revisado_por_id")
  revisadoAt    DateTime? @map("revisado_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  pago        PedidoPagoTransferencia @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  subidoPor   Usuario                 @relation("ComprobanteSubidoPor", fields: [subidoPorId], references: [id])
  revisadoPor Usuario?                @relation("ComprobanteRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  @@index([pagoId, estado])
  @@index([sha256])
  @@map("pagos_comprobantes")
}

// Bitácora de SOLO AGREGAR: el código nunca hace UPDATE ni DELETE sobre esta tabla. Cada
// transición de un pago escribe su fila en la MISMA transacción que la transición.
model PagoTransferenciaEvento {
  id          Int                      @id @default(autoincrement())
  pagoId      Int                      @map("pago_id")
  tipo        String                   @db.VarChar(40)
  deEstado    EstadoPagoTransferencia? @map("de_estado")
  aEstado     EstadoPagoTransferencia? @map("a_estado")
  actorId     Int?                     @map("actor_id")
  // String y no RolUsuario: también hay actores que no son usuarios (el agente de VFP, el sistema).
  actorRol    String?                  @map("actor_rol") @db.VarChar(20)
  actorNombre String?                  @map("actor_nombre") @db.VarChar(100)
  ip          String?                  @db.VarChar(45)
  detalle     Json?
  createdAt   DateTime                 @default(now()) @map("created_at")

  pago PedidoPagoTransferencia @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  @@index([pagoId, createdAt])
  @@map("pagos_transferencia_eventos")
}

model Notificacion {
  id           Int               @id @default(autoincrement())
  pedidoId     Int?              @map("pedido_id")
  canal        CanalNotificacion
  tipo         TipoNotificacion
  destinatario String            @db.VarChar(200)
  payload      Json?
  exitosa      Boolean           @default(false)
  errorMsg     String?           @map("error_msg") @db.Text
  enviadaAt    DateTime          @default(now()) @map("enviada_at")

  // Relaciones
  pedido Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@index([enviadaAt])
  @@map("notificaciones")
}

// ==================== HISTORIAL Y AUDITORÍA ====================

model HistorialPedido {
  id             Int           @id @default(autoincrement())
  pedidoId       Int           @map("pedido_id")
  estadoAnterior EstadoPedido? @map("estado_anterior")
  estadoNuevo    EstadoPedido  @map("estado_nuevo")
  observacion    String?       @db.Text
  usuarioId      Int?          @map("usuario_id")
  usuarioNombre  String?       @map("usuario_nombre") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at")

  // Relaciones
  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@map("historial_pedidos")
}

// ──────────────────────────────────────────────────────────────────────────────
// Oct 2026 — DESTRABAR PEDIDOS (gerente y admin).
//
// Cuando un pedido se atora (el cliente no paga, nadie lo cobra, una propuesta sin respuesta), el gerente de la
// tienda o el admin lo resuelven desde el detalle del pedido. Cada acción deja una fila aquí: quién, con qué rol,
// qué hizo y POR QUÉ (el motivo es obligatorio). Es la bitácora de esas decisiones, aparte del historial de estados
// (`HistorialPedido`), que solo dice qué estado cambió: una acción que no cambia de estado (marcar vencida una
// transferencia) también queda aquí.
model PedidoIntervencion {
  id             Int           @id @default(autoincrement())
  pedidoId       Int           @map("pedido_id")
  tiendaId       Int           @map("tienda_id")
  // Slug de la acción (`CANCELAR_SIN_PAGO`, `MARCAR_VENCIDA`, `MARCAR_PAGADO`…). String y no enum: el catálogo de
  // acciones crece sin migración, y la validación vive en el registro de acciones del servidor.
  tipo           String        @db.VarChar(40)
  // Para el personal. NUNCA se le muestra al cliente (decisión del dueño).
  motivo         String        @db.Text
  // Lo único que el cliente puede leer en SU pedido (si entra a verlo): texto estándar de la acción más lo que el
  // gerente quiera agregar. No se manda por correo.
  mensajeCliente String?       @map("mensaje_cliente") @db.Text
  actorId        Int?          @map("actor_id")
  actorRol       RolUsuario?   @map("actor_rol")
  actorNombre    String        @map("actor_nombre") @db.VarChar(120)
  estadoAntes    EstadoPedido? @map("estado_antes")
  estadoDespues  EstadoPedido? @map("estado_despues")
  detalle        Json?
  createdAt      DateTime      @default(now()) @map("created_at")

  pedido Pedido                  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tareas TareaSistemaComercial[]

  @@index([pedidoId, createdAt])
  @@index([tiendaId, createdAt])
  @@map("pedido_intervenciones")
}

// Oct 2026 — por qué canceló el CLIENTE su pedido. Es OPCIONAL (como Amazon o Uber: la lista corta se puede omitir sin
// fricción), así que la fila solo existe si el cliente eligió un motivo; omitirlo no deja nada.
//
// Es para el negocio (analítica) y para el gerente/admin en el detalle del pedido. NO va al historial del pedido ni
// al correo del cliente: por eso es una tabla aparte y no una columna de `Pedido` (que muchas respuestas devuelven entera).
//
// `motivo` es un slug validado en el servidor (`core/motivos-cancelacion-cliente.ts`), no un enum de la BD: igual que
// `PedidoIntervencion.tipo`, el catálogo puede crecer sin migración.
model PedidoCancelacionCliente {
  id               Int          @id @default(autoincrement())
  pedidoId         Int          @unique @map("pedido_id")
  tiendaId         Int          @map("tienda_id")
  usuarioId        Int?         @map("usuario_id")
  motivo           String       @db.VarChar(30)
  // Solo con el motivo «Otro»: lo que el cliente escribió (máx. 200).
  detalle          String?      @db.VarChar(200)
  // En qué punto estaba el pedido al cancelar: no es lo mismo cancelar esperando a bodega que ya listo en tienda.
  estadoAlCancelar EstadoPedido @map("estado_al_cancelar")
  createdAt        DateTime     @default(now()) @map("created_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([tiendaId, createdAt])
  @@index([motivo, createdAt])
  @@map("pedido_cancelaciones_cliente")
}

// Oct 2026 — lo que la nube hizo y el Sistema Comercial todavía NO sabe.
//
// Si un pedido que YA tiene folio en el Sistema Comercial (su fila de `PedidoPendienteEnvio` está PROCESADO) se
// cancela, o se marca pagado a mano, en la nube, el ERP no se entera: alguien tiene que reflejarlo allá. Esta tabla es
// esa lista de pendientes. El que lo hace en la tienda es el cajero (es quien opera el Sistema Comercial). Se cierra
// SOLA cuando el ERP lo confirma por el agente (`SWCANCEL` / `FINALIZADA`), o a mano ("ya lo hice" / "no aplica").
model TareaSistemaComercial {
  id                Int            @id @default(autoincrement())
  pedidoId          Int            @map("pedido_id")
  tiendaId          Int            @map("tienda_id")
  tipo              TipoTareaErp
  estado            EstadoTareaErp @default(PENDIENTE)
  // Foto de lo que había al crearla: con qué folio buscarlo en el Sistema Comercial.
  folio             String?        @db.VarChar(10)
  erpIdPedido       Int?           @map("erp_id_pedido")
  // Por qué existe (la observación de la cancelación o la referencia del cobro manual). Para el personal.
  motivo            String         @db.Text
  creadaPorId       Int?           @map("creada_por_id")
  creadaPorRol      String?        @map("creada_por_rol") @db.VarChar(20)
  creadaPorNombre   String?        @map("creada_por_nombre") @db.VarChar(120)
  intervencionId    Int?           @map("intervencion_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  resueltaAt        DateTime?      @map("resuelta_at")
  resueltaPorId     Int?           @map("resuelta_por_id")
  resueltaPorNombre String?        @map("resuelta_por_nombre") @db.VarChar(120)
  // 'ERP' (lo confirmó el agente), 'MANUAL' (alguien dijo "ya lo hice") o 'DESCARTADA' (no aplica, con nota).
  resueltaVia       String?        @map("resuelta_via") @db.VarChar(12)
  notaResolucion    String?        @map("nota_resolucion") @db.Text

  pedido       Pedido              @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  intervencion PedidoIntervencion? @relation(fields: [intervencionId], references: [id], onDelete: SetNull)

  @@index([tiendaId, estado, createdAt])
  @@index([pedidoId, estado])
  // Una sola tarea ABIERTA por pedido y tipo: el índice único parcial (`WHERE estado = 'PENDIENTE'`) vive en la
  // migración, porque Prisma no sabe modelarlo.
  @@map("tareas_sistema_comercial")
}

enum TipoTareaErp {
  // La nube canceló el pedido y en el Sistema Comercial sigue vivo: hay que cancelarlo allá.
  CANCELAR_EN_ERP
  // La nube lo marcó pagado a mano y el Sistema Comercial no tiene el cobro: hay que registrarlo allá.
  REGISTRAR_COBRO_EN_ERP
  // La nube canceló un pedido que YA estaba cobrado (el ERP lo tiene FINALIZADO): hay que anular la venta allá y devolver
  // el dinero. Es distinta de CANCELAR_EN_ERP: cancelar un pedido sin cobro no toca facturas ni caja.
  ANULAR_VENTA_EN_ERP
}

// Oct 2026 (destrabar, etapa 3) — la CONCILIACIÓN ACTIVA: lo que el agente encuentra al comparar, pedido por pedido, la
// nube contra el Sistema Comercial (el trigger de Firebird avisa de los CAMBIOS; esto verifica el RESULTADO, y cubre lo
// que un evento perdido, un agente caído o un trigger sin instalar dejaron sin avisar).
//
// Una fila ABIERTA (`resueltoAt` null) por pedido y tipo (índice único parcial en la migración). Los tipos que la nube
// corrige sola (`curado`: COBRO_PERDIDO, CANCELACION_PERDIDA) nacen ya resueltos: quedan para que se vea que pasó. El
// resto pide a una persona; se cierran solos en cuanto la comparación siguiente ya no los encuentra.
model ConciliacionHallazgo {
  id           Int       @id @default(autoincrement())
  tiendaId     Int       @map("tienda_id")
  pedidoId     Int       @map("pedido_id")
  // Slug (ver `conciliacion.util.ts`). String y no enum: el catálogo crece sin migración.
  tipo         String    @db.VarChar(40)
  // Qué dice cada lado (estado de la nube, SWCANCEL/FINALIZADA/total del ERP): para el personal.
  detalle      Json?
  curado       Boolean   @default(false)
  primeraVezAt DateTime  @default(now()) @map("primera_vez_at")
  ultimaVezAt  DateTime  @default(now()) @map("ultima_vez_at")
  resueltoAt   DateTime? @map("resuelto_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, resueltoAt])
  @@index([pedidoId])
  @@map("conciliacion_hallazgos")
}

enum EstadoTareaErp {
  PENDIENTE
  HECHA
  DESCARTADA
}

model LogActividad {
  id          Int      @id @default(autoincrement())
  usuarioId   Int?     @map("usuario_id")
  pedidoId    Int?     @map("pedido_id")
  accion      String   @db.VarChar(50)
  descripcion String   @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relaciones
  usuario Usuario? @relation(fields: [usuarioId], references: [id])
  pedido  Pedido?  @relation(fields: [pedidoId], references: [id])

  @@index([usuarioId])
  @@index([pedidoId])
  @@index([createdAt])
  @@map("log_actividades")
}

// ==================== KIOSKOS ====================

// Un kiosko representa una tablet física en una tienda. El cliente que
// llega usa SU propia cuenta (no hay cuenta kiosko compartida). El kiosko
// sólo aporta trazabilidad: cada pedido guardará kioskoId para que el
// cliente vea en su historial "Pedido X hecho en kiosko Y, tienda Z".
model Kiosko {
  id                  Int          @id @default(autoincrement())
  tiendaId            Int          @map("tienda_id")
  // Lo asigna el sistema por tienda ("Kiosko 1", "Kiosko 2"…): nadie lo teclea, así no hay duplicados ni
  // erratas ("Kiosko 1" vs "kiosko 1") y el mostrador lee "Avisó: Kiosko 2".
  nombre              String       @db.VarChar(50)
  // Dónde está la tablet, para reconocerla ("Entrada", "Junto a caja"). Opcional y editable.
  ubicacion           String?      @db.VarChar(40)
  // ACTIVO/INACTIVO es solo el interruptor del admin o gerente. "Aún sin tablet" no es un estado: se deduce de
  // `deviceTokenHash`/`primerConexionAt` (ver `calcularSaludKiosko`).
  estado              EstadoKiosko @default(ACTIVO)
  activadoAt          DateTime     @default(now()) @map("activado_at")
  activadoPorId       Int          @map("activado_por_id")
  desactivadoAt       DateTime?    @map("desactivado_at")
  desactivadoPorId    Int?         @map("desactivado_por_id")
  // Heartbeat desde la tablet cada 60s. NULL = kiosko nunca reportado
  // (recién activado) o tablet apagada. La UI admin usa esto para alertar.
  ultimoHeartbeat     DateTime?    @map("ultimo_heartbeat")
  // Se setea en el primer heartbeat que activa el kiosko (transición
  // INACTIVO → ACTIVO). NULL = la tablet nunca se conectó.
  // La UI admin usa esto para distinguir "Inactivo · pendiente de conectar"
  // (estado=INACTIVO + primerConexionAt IS NULL) vs "Inactivo · desactivado"
  // (estado=INACTIVO + primerConexionAt IS NOT NULL).
  primerConexionAt    DateTime?    @map("primer_conexion_at")
  // PR2 (kiosko-profesional, sep 2026): identidad de dispositivo.
  // Hash SHA-256 del token que el admin pega en la tablet al activarla.
  // Se exige vía header `X-Kiosko-Token` en heartbeat y en crear pedido
  // para impedir spoofing de X-Kiosko-Id (que es SERIAL y enumerable).
  // El token en claro NUNCA se persiste — solo se retorna al admin una vez.
  // NULL = kiosko activado antes de este cambio (legacy); el admin debe
  // regenerar para que el dispositivo pueda operar.
  deviceTokenHash     String?      @unique @map("device_token_hash") @db.VarChar(64)
  deviceTokenCreadoAt DateTime?    @map("device_token_creado_at")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relaciones
  tienda          Tienda          @relation(fields: [tiendaId], references: [id])
  activadoPor     Usuario         @relation("KioskoActivador", fields: [activadoPorId], references: [id])
  desactivadoPor  Usuario?        @relation("KioskoDesactivador", fields: [desactivadoPorId], references: [id])
  pedidos         Pedido[]        @relation("PedidoKioskoOrigen")
  // PR7 (sep 2026): pedidos donde ESTE kiosko anunció la llegada (no
  // donde se crearon).
  pedidosLlegada  Pedido[]        @relation("PedidoKioskoLlegada")
  emparejamientos KioskoPairing[]

  @@unique([tiendaId, nombre])
  @@index([tiendaId, estado])
  @@map("kioskos")
}

/// Emparejamiento de una tablet con un kiosko.
///
/// Resuelve el caso en que la tablet PERDIÓ su credencial (actualización de la
/// app, borrado de almacenamiento, reinstalación). El personal de tienda no
/// puede recuperarla por su cuenta — no puede navegar a ajustes ni borrar
/// datos — así que la recuperación es remota:
///
///   1. La tablet (sin credencial) pide un emparejamiento y muestra un CÓDIGO
///      de 6 dígitos en su pantalla.
///   2. El encargado lee el código al admin; el admin lo teclea en su panel.
///   3. El admin autoriza y elige a qué kiosko pertenece esa tablet.
///   4. La tablet reclama el token y se configura sola.
///
/// SEGURIDAD — el código NO es la credencial. Un código de 6 dígitos es
/// adivinable y además es audible/visible (cualquiera en la tienda puede
/// leerlo). Lo que AUTORIZA el reclamo es `deviceSecretHash`: un secreto que la
/// tablet genera y NUNCA sale de su memoria. El código sólo sirve para que el
/// admin correlacione la solicitud con la tablet que tiene enfrente.
///
/// El código en claro nunca se persiste (sólo su SHA-256), igual que el device
/// token.
model KioskoPairing {
  id               String              @id @default(cuid())
  /// SHA-256 del código de 6 dígitos. Único mientras está vivo.
  codeHash         String              @unique @map("code_hash") @db.VarChar(64)
  /// SHA-256 del secreto que genera la tablet. Es lo que autoriza el reclamo.
  deviceSecretHash String              @map("device_secret_hash") @db.VarChar(64)
  estado           KioskoPairingEstado @default(PENDIENTE)

  /// Pistas que la tablet conoce de sí misma (no son secretos, no autorizan).
  tiendaIdHint Int? @map("tienda_id_hint")
  kioskoIdHint Int? @map("kiosko_id_hint")

  /// Kiosko al que el admin autorizó vincular esta tablet.
  kioskoId Int?    @map("kiosko_id")
  kiosko   Kiosko? @relation(fields: [kioskoId], references: [id], onDelete: Cascade)

  /// Auditoría: quién autorizó y cuándo.
  aprobadoPorId Int?      @map("aprobado_por_id")
  aprobadoPor   Usuario?  @relation("KioskoPairingAprobador", fields: [aprobadoPorId], references: [id])
  aprobadoAt    DateTime? @map("aprobado_at")
  reclamadoAt   DateTime? @map("reclamado_at")

  /// Intentos fallidos de canje. Se cuentan POR CÓDIGO (no por IP): un
  /// atacante con varias IPs no puede multiplicar sus intentos, y 5 fallos
  /// queman ese código vengan de donde vengan.
  intentosFallidos Int @default(0) @map("intentos_fallidos")

  /// Contexto para que el admin reconozca la solicitud (no autoriza nada).
  ipPrimeraVista String? @map("ip_primera_vista") @db.VarChar(64)
  userAgent      String? @map("user_agent") @db.VarChar(255)

  expiraAt  DateTime @map("expira_at")
  createdAt DateTime @default(now()) @map("created_at")
  /// Se actualiza con cada cambio de estado. Permite retener un tiempo las
  /// filas terminales (RECLAMADO, CANCELADO, EXPIRADO) y luego purgarlas.
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado, expiraAt])
  @@index([kioskoId])
  @@index([estado, updatedAt])
  @@map("kiosko_pairings")
}

enum KioskoPairingEstado {
  PENDIENTE
  APROBADO
  RECLAMADO
  EXPIRADO
  CANCELADO
}

// ==================== FAVORITOS ====================

model Favorito {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  productoId Int      @map("producto_id")
  createdAt  DateTime @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, productoId])
  @@index([usuarioId])
  @@map("favoritos")
}

// ==================== PASSWORD RESET ====================

// F8 (jul 2026): tokens de un solo uso para recuperación de contraseña.
// `token` guarda el SHA256 del token random que se manda por email (nunca
// el token en claro). Al usarse se marca usedAt; expirado o usado = inválido.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  token     String    @unique @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipOrigen  String?   @map("ip_origen") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ==================== REFRESH TOKENS (F12 ago 2026) ====================
// Rotación + revocación de refresh tokens. Cada refresh emite un token nuevo
// y revoca el anterior; logout revoca todos los del usuario. El token se
// guarda como hash SHA256 (si la BD se filtra, los tokens en claro no están
// expuestos). El `familyId` agrupa la cadena de rotaciones de una sesión:
// si un token de una familia se reutiliza tras ser rotado, se revoca toda
// la familia (detección de robo).
model RefreshToken {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  familyId   String    @map("family_id") @db.VarChar(36)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy Int?      @map("replaced_by")
  ipOrigen   String?   @map("ip_origen") @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ==================== SINCRONIZACIÓN BIDIRECCIONAL (F9 ago 2026) ====================
// Infraestructura para sincronizar PostgreSQL (nube) con Firebird local
// (DATOSINV.FDB + BANDEJA_SYNC). El agente local corre en el servidor
// central de Firebird y replica cambios en ambos sentidos.

// Mapeo polimórfico entre IDs de la nube (PostgreSQL) y Firebird local.
// Una sola fila = "este entityId en la nube corresponde a este ID local
// en Firebird tienda X". Soporta el caso de un usuario que es cliente en
// varias tiendas (un ExternalRef por tienda).
model ExternalRef {
  id            Int      @id @default(autoincrement())
  systemEntity  String   @db.VarChar(40) // USUARIO|TIENDA|PRODUCTO|CORRIDA|COLOR|TALLA|PRECIO|PRECIOCO|PEDIDO
  systemId      Int // PK en PG
  localEntity   String   @db.VarChar(40) // CLIENTES|CLIENTESCXC|TIENDAS|PRODUCTOS|...
  localId       Int
  localTiendaId Int? // FK lógica a TIENDAS.IDTIENDA. NULL para entidades globales.
  syncedAt      DateTime @default(now()) @map("synced_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([systemEntity, systemId, localEntity, localTiendaId])
  @@index([systemEntity, systemId])
  @@index([localEntity, localId])
  @@index([localEntity, localTiendaId, localId])
  @@map("external_refs")
}

// Watermark por tienda: el agente local guarda aquí el último BANDEJA_SYNC.ID
// que ya subió a la nube. El checkpoint es por tienda (no por instancia
// de agente), para soportar reinstalación del agente sin perder progreso.
model SyncCheckpoint {
  id                          Int       @id @default(autoincrement())
  tiendaId                    Int       @unique @map("tienda_id")
  ultimoBANDEJAId             BigInt    @default(0) @map("ultimo_bandeja_id")
  ultimoHeartbeatAt           DateTime? @map("ultimo_heartbeat_at")
  agentVersion                String?   @map("agent_version") @db.VarChar(20)
  lastError                   String?   @map("last_error") @db.Text
  lastErrorAt                 DateTime? @map("last_error_at")
  // Oct 2026: la última vez que el agente COMPARÓ los pedidos de esta tienda contra el Sistema Comercial (la
  // conciliación activa) y cuántos revisó. Sin esto "no hay diferencias" y "nadie ha comparado" se ven igual.
  ultimaConciliacionAt        DateTime? @map("ultima_conciliacion_at")
  ultimaConciliacionRevisados Int?      @map("ultima_conciliacion_revisados")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@map("sync_checkpoints")
}

// Cola de pedidos NUEVOS nube→Firebird. Cuando ClienteService.crearPedido
// genera un pedido, también inserta aquí un registro. El agente lo sondea,
// lo baja a Firebird via GRABAR_PEDIDOS + GRABAR_MOVPED, y al terminar
// hace ack cambiando estado a PROCESADO con externalIdPEDIDOS.
model PedidoPendienteEnvio {
  id                Int       @id @default(autoincrement())
  pedidoId          Int       @unique @map("pedido_id")
  estado            String    @default("PENDIENTE") @db.VarChar(20)
  // PENDIENTE → PROCESSING → PROCESADO; RETRY vuelve a ser elegible.
  intentos          Int       @default(0)
  claimedBy         String?   @map("claimed_by") @db.VarChar(100)
  leaseToken        String?   @map("lease_token") @db.VarChar(80)
  leaseUntil        DateTime? @map("lease_until")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at")
  ultimoError       String?   @map("ultimo_error") @db.Text
  ultimoIntentoAt   DateTime? @map("ultimo_intento_at")
  ultimoErrorCode   String?   @map("ultimo_error_code") @db.VarChar(60)
  // IDPEDIDO en Firebird devuelto por GRABAR_PEDIDOS. Permite idempotencia
  // en reintentos: si el agente crashea entre el INSERT y el ack, al
  // reintentar usa este ID en lugar de generar uno nuevo.
  externalIdPEDIDOS Int?      @map("external_id_pedidos")
  externalFolio     String?   @map("external_folio") @db.VarChar(10)
  createdAt         DateTime  @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([estado, createdAt])
  // Restaurados (F9 ago 2026): estos índices los creó la migración 2210 pero
  // el schema los había perdido. Sin ellos el poll-pedidos hace seq scan sobre
  // pedidos_pendientes_envio cuando crece.
  @@index([estado, nextAttemptAt, leaseUntil], map: "pedidos_pendientes_envio_claim_idx")
  @@index([leaseToken], map: "pedidos_pendientes_envio_lease_token_idx")
  // PR7 (sep 2026): índice en externalFolio para que la búsqueda de
  // kiosko-llegada no haga seq scan cuando crezca el histórico.
  @@index([externalFolio])
  @@map("pedidos_pendientes_envio")
}

// Oct 2026 (parte B): la cola de FOLIOS. Cuando bodega cierra el surtido el pedido necesita su folio REAL del
// Sistema Comercial (para el ticket y el QR) y la nube no puede llamar al agente: deja aquí la solicitud, el agente
// la recoge en su siguiente ciclo (`GET sync/agent/poll-folios`), reserva el consecutivo en Firebird y la contesta
// (`POST sync/agent/folios-ack`). Mismo patrón claim/lease que `PedidoPendienteEnvio`, pero NO envía el pedido: solo
// toma un número (el pedido sigue sin existir en el ERP hasta que mostrador lo manda a pagar). 1:1 con el pedido.
model PedidoFolioSolicitud {
  id            Int       @id @default(autoincrement())
  pedidoId      Int       @unique @map("pedido_id")
  tiendaId      Int       @map("tienda_id")
  // PENDIENTE → PROCESSING (el agente la tomó) → ASIGNADO. Un error del agente la regresa a PENDIENTE con su espera.
  estado        String    @default("PENDIENTE") @db.VarChar(20)
  intentos      Int       @default(0)
  claimedBy     String?   @map("claimed_by") @db.VarChar(100)
  leaseToken    String?   @map("lease_token") @db.VarChar(80)
  leaseUntil    DateTime? @map("lease_until")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  ultimoError   String?   @map("ultimo_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  asignadoAt    DateTime? @map("asignado_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  // El poll del agente (por tienda, lo no asignado) y el semáforo de salud.
  @@index([tiendaId, estado, nextAttemptAt])
  @@map("pedido_folio_solicitudes")
}

// F13 (sep 2026): lista de reposición de bodega.
//
// Cuando el cliente RECHAZA una propuesta, el pedido se cancela y los
// productos que bodega ya había apartado tienen que volver físicamente al
// anaquel. Como el modelo B2B NO maneja inventario (el modelo Stock se
// eliminó en el refactor B2B — ver el comentario sobre PrecioCO), esto NO es
// un contador que se suma: es una lista de trabajo para bodega con
// confirmación humana.
//
// 1:1 con Pedido (pedidoId es @unique). Sólo existe si el pedido se canceló
// por rechazo del cliente; una cancelación desde Firebird (SWCANCEL) no la
// crea, porque en ese caso el ERP ya sabe que el pedido murió.
model PedidoReposicion {
  id            Int              @id @default(autoincrement())
  pedidoId      Int              @unique @map("pedido_id")
  estado        EstadoReposicion @default(PENDIENTE)
  // Snapshot de los items a reponer (mismo shape que ItemPedido relevante:
  // productoNombre, productoCodigo, tallaNombre, colorNombre, corridaNombre,
  // cantidad). Se guarda como snapshot para que la lista no cambie aunque el
  // pedido o sus items se modifiquen después.
  items         Json             @db.Json
  // Por qué se canceló (texto del cliente al rechazar, o motivo del sistema).
  motivo        String?          @db.Text
  creadaAt      DateTime         @default(now()) @map("creada_at")
  repuestoAt    DateTime?        @map("repuesto_at")
  repuestoPorId Int?             @map("repuesto_por_id")

  // Relaciones
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  repuestoPor Usuario? @relation("ReposicionReponedor", fields: [repuestoPorId], references: [id], onDelete: SetNull)

  @@index([estado, creadaAt])
  @@map("pedidos_reposicion")
}

// Auditoría bidireccional: cada evento de sync (cambio procesado, error,
// ack, heartbeat) deja un rastro para debugging desde panel admin.
model SyncEventInbox {
  id              Int       @id @default(autoincrement())
  eventId         String    @unique @map("event_id") @db.VarChar(160)
  tiendaId        Int       @map("tienda_id")
  bandejaId       BigInt?   @map("bandeja_id")
  entidad         String    @db.VarChar(40)
  operacion       String    @db.VarChar(1)
  localId         Int       @map("local_id")
  estado          String    @default("PROCESANDO") @db.VarChar(20)
  intentos        Int       @default(0)
  nextAttemptAt   DateTime  @default(now()) @map("next_attempt_at")
  ultimoErrorCode String?   @map("ultimo_error_code") @db.VarChar(60)
  payload         Json
  mensaje         String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  processedAt     DateTime? @map("processed_at")

  // Relación con Tienda (F9 ago 2026): la migración 2211 creó el FK en BD
  // pero el schema nunca declaró la relación. Sin esto, Prisma cree que
  // tiendaId es huérfano y borra el constraint en migrate dev.
  tienda Tienda @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, createdAt])
  @@index([estado, createdAt])
  // Restaurado (F9 ago 2026): la migración 2213 lo creó pero el schema lo perdió.
  @@index([estado, nextAttemptAt], map: "sync_event_inbox_retry_idx")
  @@map("sync_event_inbox")
}

model SyncEventLog {
  id          Int      @id @default(autoincrement())
  tiendaId    Int?     @map("tienda_id")
  direccion   String   @map("direccion") @db.VarChar(10) // UP | DOWN
  tipo        String   @map("tipo") @db.VarChar(20) // CATALOGO|CLIENTE|PEDIDO|PAGO|HEARTBEAT
  referencia  String?  @map("referencia") @db.VarChar(100)
  exitoso     Boolean  @default(true)
  mensaje     String?  @db.Text
  payloadSize Int?     @map("payload_size")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tiendaId, createdAt])
  @@index([tipo, exitoso, createdAt])
  @@map("sync_event_log")
}

// Outbox de eventos realtime (Socket.IO). Cada evento que se emite a un room
// se persiste aquí ANTES de emitir en vivo. Si el proceso muere entre el
// persist y el emit, la fila queda con `emitidoAt = null` y el worker
// (RealtimeOutboxWorker) la re-emite al arrancar. `emitidoAt` se setea a now
// en el flujo normal (ya emitido en vivo), así el worker solo re-emite los
// huérfanos. Retención: 1h (el worker borra lo más viejo).
model RealtimeEventOutbox {
  id        Int       @id @default(autoincrement())
  room      String    @db.VarChar(100) // 'tienda-1' | 'pedido-5' | 'user-3' | 'admin:all'
  evento    String    @db.VarChar(60) // 'pedido.creado', 'pedido.estado', ...
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  emitidoAt DateTime? @map("emitido_at") // null = pendiente de re-emitir

  @@index([room, createdAt])
  @@index([emitidoAt])
  @@map("realtime_event_outbox")
}

// Configuración editable desde el panel ADMIN (clave → valor). Singleton por
// `clave`. Hoy solo se usa para el logo de los correos; el patrón permite
// añadir más ajustes sin migración nueva.
//
// `valor` guarda una KEY de storage (p.ej. `branding/logo/uuid.png`), no una
// URL: el borde de la API la resuelve con StorageService, así cambiar de
// bucket o a un CDN no requiere migrar datos.
model ConfiguracionSitio {
  id        Int      @id @default(autoincrement())
  clave     String   @unique @db.VarChar(50)
  // PR5 (kiosko-profesional): ahora TEXT para soportar JSON arrays de
  // keys S3 (kiosko_idle_media con varias imágenes). El logo individual
  // cabe en 500, pero un array de keys no.
  valor     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("configuracion_sitio")
}

// ==================== IMPRESIÓN DTF (oct 2026) ====================
//
// Ver PLAN-DTF.md. Principio: el DTF NO es un `ItemPedido` (cantidad Int, variante obligatoria, promo
// de 12 piezas, bodega/propuestas/reposición y el ERP asumen prendas). Es un carril paralelo colgado
// del pedido, con su propia máquina de estados, y el pedido espera en `EN_DTF`.
//
// Los índices parciales que Prisma no sabe declarar (si hicieran falta) viven en la migración SQL.

enum TecnologiaDtf {
  TEXTIL
  UV
}

enum EstadoDtf {
  BORRADOR // en el carrito, sin pedido (expira)
  ARCHIVO_PENDIENTE // el pedido existe pero el archivo llega después (USB / correo, subido por el personal)
  RECIBIDO // archivo subido, en la cola de revisión
  EN_REVISION // una persona de Impresión lo tomó
  NECESITA_CORRECCION // se pidió otra versión: la pelota es del cliente
  APROBADO // listo para imprimir
  EN_IMPRESION
  IMPRESO // listo en tienda (terminal del trabajo; la entrega es del pedido)
  RECHAZADO // no se puede hacer (terminal)
  CANCELADO // lo quitó el cliente / un operador antes de imprimir (terminal)
  EXPIRADO // borrador abandonado (terminal)
}

enum EstadoPreflight {
  PENDIENTE
  OK
  CON_AVISOS
  BLOQUEADO
  NO_CONCLUYENTE
}

// Catálogo de reglas y tarifas de cada tecnología. Lo edita el ADMIN (no es `ConfiguracionSitio`: son
// datos estructurados). El precio sale de `productoId` (producto-servicio del ERP, con la lista del
// cliente) y, si no hay, de `precioMetro` (tarifa manual). Ver PLAN-DTF.md D5.
model DtfTipo {
  id                Int           @id @default(autoincrement())
  tecnologia        TecnologiaDtf @unique
  nombre            String        @db.VarChar(60)
  descripcion       String?       @db.Text
  productoId        Int?          @map("producto_id")
  precioMetro       Decimal?      @map("precio_metro") @db.Decimal(10, 2)
  anchoUtilCm       Decimal       @default(57) @map("ancho_util_cm") @db.Decimal(6, 1)
  toleranciaAnchoCm Decimal       @default(0.5) @map("tolerancia_ancho_cm") @db.Decimal(4, 1)
  minimoCm          Decimal       @map("minimo_cm") @db.Decimal(6, 1)
  maxAlturaCm       Decimal       @default(250) @map("max_altura_cm") @db.Decimal(6, 1)
  // 100 = metro completo · 50 = medio metro · 20 = de 20 en 20 · 1 = exacto. Ver PLAN-DTF.md §8.
  pasoCobroCm       Int           @map("paso_cobro_cm")
  dpiMinimo         Int           @default(300) @map("dpi_minimo")
  // Debajo de este tamaño de letra el texto "se desaparece" al imprimir (aviso, no bloqueo).
  textoMinPt        Decimal       @default(6) @map("texto_min_pt") @db.Decimal(4, 1)
  // D15: exigir pago antes de imprimir (apagado = se cobra al recoger/entregar, como las prendas).
  pagoAntes         Boolean       @default(false) @map("pago_antes")
  activo            Boolean       @default(true)
  orden             Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  producto Producto?   @relation(fields: [productoId], references: [id], onDelete: SetNull)
  tiendas  TiendaDtf[]
  trabajos PedidoDtf[]

  @@map("dtf_tipos")
}

// Qué tienda imprime qué tecnología, y con qué máquina. El ADMIN lo enciende en /admin/dtf (D16).
model TiendaDtf {
  id                  Int      @id @default(autoincrement())
  tiendaId            Int      @map("tienda_id")
  tipoId              Int      @map("tipo_id")
  activo              Boolean  @default(true)
  maquina             String?  @db.VarChar(60)
  // Metros por hora: sirve para la hora estimada de entrega (la columna HORA del Excel).
  velocidadMetrosHora Decimal? @map("velocidad_metros_hora") @db.Decimal(6, 2)
  // "15:00": lo que llega después sale al día siguiente. Hora local de PAGOS_ZONA_HORARIA.
  horaCorte           String?  @map("hora_corte") @db.VarChar(5)
  cupoMetrosDia       Decimal? @map("cupo_metros_dia") @db.Decimal(8, 2)
  fueraDeServicio     Boolean  @default(false) @map("fuera_de_servicio")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tienda Tienda  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  tipo   DtfTipo @relation(fields: [tipoId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, tipoId])
  @@map("tiendas_dtf")
}

// Un trabajo = un archivo = un renglón (como en la hoja de Excel). `pedidoId` es null mientras es
// BORRADOR (vive en el servidor porque un archivo no cabe en el carrito del navegador).
model PedidoDtf {
  id          Int       @id @default(autoincrement())
  pedidoId    Int?      @map("pedido_id")
  usuarioId   Int       @map("usuario_id")
  tiendaId    Int       @map("tienda_id")
  tipoId      Int       @map("tipo_id")
  estado      EstadoDtf @default(BORRADOR)
  // "CÁNCER DE MAMA": la "descripción" de la hoja. Es el asa con la que el cliente distingue sus archivos.
  nombre      String    @db.VarChar(80)
  notaCliente String?   @map("nota_cliente") @db.Text
  copias      Int       @default(1)

  // Medidas del archivo vigente y cobro: SNAPSHOT congelado al cotizar.
  anchoCm        Decimal? @map("ancho_cm") @db.Decimal(6, 1)
  altoCm         Decimal? @map("alto_cm") @db.Decimal(7, 1)
  metrosCobrados Decimal? @map("metros_cobrados") @db.Decimal(8, 2)
  precioMetro    Decimal  @default(0) @map("precio_metro") @db.Decimal(10, 2)
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)

  versionVigente Int       @default(0) @map("version_vigente")
  // Reparto de trabajo entre varias personas de Impresión (guarda atómica, como bodega).
  asignadoAId    Int?      @map("asignado_a_id")
  asignadoAt     DateTime? @map("asignado_at")

  correccionMotivos Json?   @map("correccion_motivos")
  correccionNota    String? @map("correccion_nota") @db.Text
  rechazoMotivo     String? @map("rechazo_motivo") @db.VarChar(40)
  rechazoNota       String? @map("rechazo_nota") @db.Text
  // El cliente siguió pese a un aviso de la revisión automática (p. ej. 150 dpi).
  aceptoRiesgo      Boolean @default(false) @map("acepto_riesgo")

  // Línea de tiempo. `recibidoAt` es EL LUGAR en la cola y NO se reinicia al subir una versión nueva.
  recibidoAt     DateTime? @map("recibido_at")
  aprobadoAt     DateTime? @map("aprobado_at")
  planoBlancoAt  DateTime? @map("plano_blanco_at")
  imprimiendoAt  DateTime? @map("imprimiendo_at")
  impresoAt      DateTime? @map("impreso_at")
  horaEstimadaAt DateTime? @map("hora_estimada_at")
  ordenCola      Int?      @map("orden_cola")
  reimpresiones  Int       @default(0)
  expiraAt       DateTime? @map("expira_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pedido    Pedido?            @relation(fields: [pedidoId], references: [id], onDelete: Restrict)
  usuario   Usuario            @relation("DtfDueno", fields: [usuarioId], references: [id])
  asignadoA Usuario?           @relation("DtfAsignado", fields: [asignadoAId], references: [id], onDelete: SetNull)
  tienda    Tienda             @relation(fields: [tiendaId], references: [id])
  tipo      DtfTipo            @relation(fields: [tipoId], references: [id])
  archivos  PedidoDtfArchivo[]
  eventos   PedidoDtfEvento[]
  mensajes  PedidoDtfMensaje[]

  @@index([tiendaId, estado])
  @@index([pedidoId])
  @@index([usuarioId, estado])
  @@index([estado, expiraAt])
  @@map("pedidos_dtf")
}

// Una fila por VERSIÓN del archivo; nunca se pisa. La BD guarda la KEY de almacenamiento PRIVADO,
// jamás una URL (los diseños son propiedad intelectual del cliente).
model PedidoDtfArchivo {
  id              Int             @id @default(autoincrement())
  dtfId           Int             @map("dtf_id")
  version         Int
  archivoKey      String          @map("archivo_key") @db.VarChar(255)
  previewKey      String?         @map("preview_key") @db.VarChar(255)
  nombreOriginal  String          @map("nombre_original") @db.VarChar(200)
  // Detectado por la firma binaria del archivo, no el que declara el cliente.
  mime            String          @db.VarChar(40)
  bytes           Int
  sha256          String          @db.VarChar(64)
  // WEB | CELULAR_QR | ASISTIDO
  canal           String          @db.VarChar(20)
  subidoPorId     Int?            @map("subido_por_id")
  subidoPorRol    String?         @map("subido_por_rol") @db.VarChar(20)
  preflightEstado EstadoPreflight @default(PENDIENTE) @map("preflight_estado")
  // Resultado por regla + mediciones (ver dtf/preflight). Es una AYUDA: la última palabra es de Impresión.
  preflight       Json?
  createdAt       DateTime        @default(now()) @map("created_at")

  trabajo PedidoDtf @relation(fields: [dtfId], references: [id], onDelete: Cascade)

  @@unique([dtfId, version])
  @@index([sha256])
  @@index([preflightEstado, createdAt])
  @@map("pedidos_dtf_archivos")
}

// Bitácora de SOLO AGREGAR (el código nunca hace UPDATE ni DELETE aquí).
model PedidoDtfEvento {
  id          Int        @id @default(autoincrement())
  dtfId       Int        @map("dtf_id")
  tipo        String     @db.VarChar(40)
  deEstado    EstadoDtf? @map("de_estado")
  aEstado     EstadoDtf? @map("a_estado")
  actorId     Int?       @map("actor_id")
  actorRol    String?    @map("actor_rol") @db.VarChar(20)
  actorNombre String?    @map("actor_nombre") @db.VarChar(100)
  detalle     Json?
  createdAt   DateTime   @default(now()) @map("created_at")

  trabajo PedidoDtf @relation(fields: [dtfId], references: [id], onDelete: Cascade)

  @@index([dtfId, createdAt])
  @@map("pedidos_dtf_eventos")
}

// "Hablar con el diseñador": hilo por trabajo entre el cliente e Impresión. Es una tabla propia y no
// `PedidoMensaje` a propósito (el chat de pedido es del asesor de ventas y trae sus reglas de
// lectura/visibilidad); si luego se unifica, es una migración de datos.
model PedidoDtfMensaje {
  id        Int        @id @default(autoincrement())
  dtfId     Int        @map("dtf_id")
  autorId   Int        @map("autor_id")
  autorRol  RolUsuario @map("autor_rol")
  contenido String     @db.Text
  createdAt DateTime   @default(now()) @map("created_at")

  trabajo PedidoDtf @relation(fields: [dtfId], references: [id], onDelete: Cascade)
  autor   Usuario   @relation(fields: [autorId], references: [id])

  @@index([dtfId, createdAt])
  @@map("pedidos_dtf_mensajes")
}
